---
export interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<div class="flex flex-col items-center text-center relative z-10 w-full md:w-64">
  <!-- Numbered Circle -->
  <div class="w-12 h-12 rounded-full bg-[#3B82F6] text-white font-bold text-lg flex items-center justify-center mb-6 shadow-lg shadow-blue-500/30 z-20 relative ring-4 ring-[#F8FBFF]">
    {number}
  </div>
  
  <h4 class="text-lg font-bold text-[#0E2344] mb-2">{title}</h4>
  
  <p class="text-sm text-gray-500 leading-relaxed px-2">
    {description}
  </p>
</div>
