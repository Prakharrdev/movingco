---
interface Props {
  type?: 'text' | 'email' | 'tel';
  placeholder?: string;
  id?: string;
  name?: string;
  class?: string;
}

const { type = 'text', placeholder, id, name, class: className = '' } = Astro.props;
---

<input 
  type={type} 
  placeholder={placeholder}
  id={id}
  name={name}
  class={`w-full h-[56px] px-4 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-white/50 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all duration-300 backdrop-blur-sm ${className}`} 
/>
