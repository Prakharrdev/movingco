---
// BackgroundTrees.astro
---

<div class="background-trees absolute bottom-0 left-0 right-0 pointer-events-none z-0 overflow-hidden">
  <!-- Mist Gradient (Bottom) -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#F8FBFF] via-[#F8FBFF]/80 to-transparent z-10"></div>
  
  <!-- Left Tree -->
  <img 
    src="/images/pine-forest-silhouette.png" 
    alt="" 
    aria-hidden="true"
    class="background-tree background-tree-left absolute object-cover opacity-10 mix-blend-multiply filter blur-[1px]"
  />
  
  <!-- Right Tree (Flipped horizontally for variety) -->
  <img 
    src="/images/pine-forest-silhouette.png" 
    alt="" 
    aria-hidden="true"
    class="background-tree background-tree-right absolute object-cover opacity-10 mix-blend-multiply filter blur-[1px] scale-x-[-1]"
  />
</div>

<style>
  .background-trees {
    block-size: clamp(16rem, 25vw, 24rem);
  }

  .background-tree {
    inline-size: clamp(18rem, 32vw, 25rem);
    block-size: clamp(13.5rem, 24vw, 18.75rem);
    bottom: clamp(-2rem, -4vw, -0.75rem);
  }

  .background-tree-left {
    left: clamp(-4rem, -6vw, -1.5rem);
  }

  .background-tree-right {
    right: clamp(-4rem, -6vw, -1.5rem);
  }
</style>
