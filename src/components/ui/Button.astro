---
interface Props {
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  size?: 'default' | 'large';
  class?: string;
}

const { variant = 'primary', type = 'button', size = 'default', class: className = '' } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-bold rounded-[16px] transition-all duration-300 ease-out hover:-translate-y-[2px]';
const sizeClasses = {
  default: 'text-[16px] px-8 py-4',
  large: 'text-[18px] px-10 h-[56px]'
};
const variantClasses = {
  primary: 'bg-[var(--color-primary)] text-white hover:shadow-[0_15px_30px_rgba(46,125,235,0.3)]',
  secondary: 'bg-white text-[var(--color-dark-navy)] hover:shadow-[0_15px_30px_rgba(0,0,0,0.1)]'
};
---

<button type={type} class={`${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`}>
  <slot />
</button>
