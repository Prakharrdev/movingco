---
import AboutContent from './AboutContent.astro';
import WaveDivider from '../shared/WaveDivider.astro';
---

<section class="relative w-full bg-[var(--color-about-bg)] py-[120px]">
  <div class="max-w-[1440px] mx-auto px-4 md:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[56px] items-start">
      
      <!-- Left: Image (Almost half section) -->
      <div class="relative w-full h-[400px] lg:h-[700px] rounded-[24px] overflow-hidden bg-slate-200 shadow-sm">
        <!-- Placeholder for actual image -->
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80');"></div>
      </div>
      
      <!-- Right: Content & Stats -->
      <div class="flex flex-col">
        <AboutContent />
      </div>
      
    </div>
  </div>
  
  <WaveDivider fill="var(--color-light-gray)" position="bottom" />
</section>

