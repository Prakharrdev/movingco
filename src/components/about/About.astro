---
import AboutContent from './AboutContent.astro';
import WaveDivider from '../shared/WaveDivider.astro';
---

<section class="about-section relative w-full bg-[var(--color-about-bg)]">
  <div class="site-container relative z-10">
    <div class="about-layout grid grid-cols-1 lg:grid-cols-2 items-start">
      
      <!-- Left: Image (Almost half section) -->
      <div class="about-image relative w-full rounded-[24px] overflow-hidden bg-slate-200 shadow-sm">
        <!-- Placeholder for actual image -->
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/about.png');"></div>
      </div>
      
      <!-- Right: Content & Stats -->
      <div class="flex flex-col">
        <AboutContent />
      </div>
      
    </div>
  </div>
  
  <WaveDivider fill="var(--color-light-gray)" position="bottom" />
</section>

<style>
  .about-section {
    padding-block: var(--section-space);
  }

  .about-layout {
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .about-image {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 64rem) {
    .about-image {
      aspect-ratio: auto;
      block-size: clamp(34rem, 44vw, 43.75rem);
    }
  }
</style>
