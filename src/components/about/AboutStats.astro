---

<div class="flex flex-col">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-[32px]">
    <!-- Card 1 -->
    <div class="bg-white rounded-[16px] p-5 flex flex-col items-center text-center shadow-sm">
      <div class="w-[48px] h-[48px] rounded-full bg-[#1B4B82] text-white flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
      </div>
      <span class="text-sm font-semibold text-[var(--color-about-navy)] leading-none mb-1">Since</span>
      <span class="text-[28px] font-bold text-[var(--color-about-primary)] leading-none mb-3">2020</span>
      <hr class="w-full border-t border-[var(--color-about-border)] mb-3" />
      <span class="text-xs text-[var(--color-about-text)] font-medium leading-tight">Serving Northern<br/>Michigan</span>
    </div>

    <!-- Card 2 -->
    <div class="bg-white rounded-[16px] p-5 flex flex-col items-center text-center shadow-sm">
      <div class="w-[48px] h-[48px] rounded-full bg-[#1B4B82] text-white flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
      </div>
      <span class="text-[32px] font-bold text-[var(--color-about-primary)] leading-none mb-3 mt-[14px]">9</span>
      <hr class="w-full border-t border-[var(--color-about-border)] mb-3" />
      <span class="text-xs text-[var(--color-about-text)] font-medium leading-tight">Professional<br/>Moving Services</span>
    </div>

    <!-- Card 3 -->
    <div class="bg-white rounded-[16px] p-5 flex flex-col items-center text-center shadow-sm">
      <div class="w-[48px] h-[48px] rounded-full bg-[#1B4B82] text-white flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
      <span class="text-[32px] font-bold text-[var(--color-about-primary)] leading-none mb-3 mt-[14px]">20+</span>
      <hr class="w-full border-t border-[var(--color-about-border)] mb-3" />
      <span class="text-xs text-[var(--color-about-text)] font-medium leading-tight">Communities<br/>Served</span>
    </div>

    <!-- Card 4 -->
    <div class="bg-white rounded-[16px] p-5 flex flex-col items-center text-center shadow-sm">
      <div class="w-[48px] h-[48px] rounded-full bg-[#1B4B82] text-white flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <span class="text-[32px] font-bold text-[var(--color-about-primary)] leading-none mb-3 mt-[14px]">7 Days</span>
      <hr class="w-full border-t border-[var(--color-about-border)] mb-3" />
      <span class="text-xs text-[var(--color-about-text)] font-medium leading-tight">Available<br/>Every Week</span>
    </div>
  </div>
  
  <div class="flex items-center gap-4 flex-wrap">
    <button class="bg-[var(--color-about-primary)] text-white px-6 py-3 rounded-[8px] font-bold text-[14px] uppercase tracking-wide hover:bg-blue-700 transition-colors shadow-sm">
      Get a Free Quote &rarr;
    </button>
    <span class="text-[var(--color-about-navy)] font-medium text-[16px]">
      or Call <a href="tel:2313429505" class="text-[var(--color-about-primary)] font-bold hover:underline">(231) 342-9505</a>
    </span>
  </div>
</div>
