---
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    title: "Local & Long-Distance Moving",
    description: "Reliable moves across town or across the state. We've got you covered.",
    image: "/images/services/local-long-distance-moving.webp",
    href: "/services/local-distance-moving",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h2"/><path d="M14 17h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>`
  },
  {
    title: "Packing & Unpacking",
    description: "Professional packing with quality materials and careful attention to every item.",
    image: "/images/services/packing-unpacking.webp",
    href: "/services/packing-unpacking",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
  },
  {
    title: "Loading & Unloading",
    description: "Safe, efficient loading and unloading to protect your belongings.",
    image: "/images/services/loading-unloading.webp",
    href: "/services/loading-unloading",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 16v-4a4 4 0 1 0-8 0v4"/><path d="M12 12h.01"/><path d="M16 12h.01"/><path d="M8 12h.01"/><path d="M3 16h18"/><path d="M5 20v-4"/><path d="M19 20v-4"/><path d="M8 16v4"/><path d="M16 16v4"/></svg>`
  },
  {
    title: "Storage & Declutter",
    description: "Secure storage solutions and help decluttering your space with ease.",
    image: "/images/services/storage-declutter.webp",
    href: "/services/storage-declutter",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
  },
  {
    title: "Apartment & Condo Moving",
    description: "Specialized moving for apartments, condos, and tight spaces.",
    image: "/images/services/apartment-condo-moving.webp",
    href: "/services/apartment-condo-moving",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>`
  },
  {
    title: "Senior Moving",
    description: "Compassionate moving services designed for seniors and their families.",
    image: "/images/services/senior-moving.webp",
    href: "/services/senior-moving",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
  },
  {
    title: "Arts & Antiques Moving",
    description: "Expert care for valuable, delicate, and one-of-a-kind items.",
    image: "/images/services/arts-antiques-moving.webp",
    href: "/services/arts-antiques",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`
  },
  {
    title: "Specialty Moving Services",
    description: "Pianos, gun safes, hot tubs, and more. We move what others can't.",
    image: "/images/services/specialty-moving-services.webp",
    href: "/services/specialty-moving-services",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
  },
  {
    title: "Commercial & Office Moving",
    description: "Minimize downtime with efficient commercial moving solutions.",
    image: "/images/services/commercial-office-moving.webp",
    href: "/services/commercial-office-moving",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
  }
];
---

<section class="section-space bg-light-gray" id="services">
  <div class="site-container">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="h-px w-12 bg-primary/30"></div>
        <span class="text-primary font-bold text-sm tracking-wider uppercase">Our Services</span>
        <div class="h-px w-12 bg-primary/30"></div>
      </div>
      
      <h2 class="text-[clamp(2rem,4vw,3rem)] font-extrabold text-dark-navy mb-4 tracking-tight">
        Complete Moving Solutions<br/>
        <span class="text-primary">Tailored to Your Needs</span>
      </h2>
      
      <p class="text-lg text-text-secondary font-medium mt-6 text-gray-600">
        From local moves to specialty services — we handle every detail<br class="hidden md:block"/> so you can focus on what matters most.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="services-grid grid gap-6 lg:gap-8">
      {services.map(service => (
        <ServiceCard 
          title={service.title}
          description={service.description}
          image={service.image}
          icon={service.icon}
          href={service.href}
        />
      ))}
    </div>
    
  </div>
</section>

<style>
  .services-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
</style>
