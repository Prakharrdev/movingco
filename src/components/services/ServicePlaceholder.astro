---
import Base from '../../layouts/Base.astro';
import Navbar from '../layout/Navbar.astro';
import PageHero from '../hero/PageHero.astro';
import Footer from '../layout/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  crumbs?: { label: string; href: string }[];
}

const { title, subtitle, image, crumbs } = Astro.props;

const breadcrumbs = crumbs ?? [
  { label: 'Home', href: '/' },
  { label: 'Moving Services', href: '/#services' },
  { label: title, href: undefined },
];
---

<Base title={title}>
  <Navbar />
  <main class="w-full min-h-[70vh] bg-[var(--color-light-gray)]">
    {image && crumbs && (
      <div class="lg:hidden">
        <PageHero
          title={title}
          subtitle={subtitle}
          image={image}
          crumbs={crumbs}
          cta={{ label: "Get a Free Quote", href: "/contact-us" }}
        />
      </div>
    )}
    <div class="hidden lg:flex w-full min-h-[70vh] items-center justify-center">
      <div class="text-center px-6 py-32">
        <nav aria-label="breadcrumb" class="flex justify-center mb-6">
          <ol class="flex items-center gap-1.5 sm:gap-2 list-none m-0 p-0 text-[clamp(0.7rem,2vw,0.875rem)] leading-tight whitespace-nowrap">
            {breadcrumbs.map((crumb, i) => (
              <li class="flex items-center gap-1.5 sm:gap-2">
                {i > 0 && <span class="text-[#6B7280] font-semibold">/</span>}
                {i === breadcrumbs.length - 1 ? (
                  <span class="text-[var(--color-primary)] font-bold truncate">{crumb.label}</span>
                ) : (
                  <a href={crumb.href} class="text-[#6B7280] hover:text-[var(--color-primary)] transition-colors truncate">{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-dark-navy)] mb-4">{title}</h1>
        {subtitle && <p class="text-lg text-[var(--color-dark-navy)]/70">{subtitle}</p>}
      </div>
    </div>
  </main>
  <Footer />
</Base>
