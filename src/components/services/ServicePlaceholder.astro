---
import Base from '../../layouts/Base.astro';
import Navbar from '../layout/Navbar.astro';
import PageHero from '../hero/PageHero.astro';
import MapSection from '../v2/sections/MapSection.astro';
import Footer from '../layout/Footer.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  crumbs?: { label: string; href: string }[];
  mapSrc?: string;
  mapTitle?: string;
}

const { title, subtitle, image, crumbs, mapSrc, mapTitle } = Astro.props;

const breadcrumbs = crumbs ?? [
  { label: 'Home', href: '/' },
  { label: 'Moving Services', href: '/#services' },
  { label: title, href: undefined },
];
---

<Base title={title}>
  <Navbar />
  <main class="service-placeholder w-full bg-[var(--color-light-gray)]">
    {image && crumbs && (
      <div class="lg:hidden">
        <PageHero
          title={title}
          subtitle={subtitle}
          image={image}
          crumbs={crumbs}
          cta={{ label: "Get a Free Quote", href: "/contact-us" }}
        />
      </div>
    )}
    <div class="service-placeholder-desktop hidden lg:flex w-full items-center justify-center">
      <div class="site-container text-center">
        <nav aria-label="breadcrumb" class="flex justify-center mb-6">
          <ol class="service-breadcrumb flex flex-wrap justify-center items-center gap-1.5 sm:gap-2 list-none m-0 p-0 text-[clamp(0.7rem,2vw,0.875rem)] leading-tight">
            {breadcrumbs.map((crumb, i) => (
              <li class="flex items-center gap-1.5 sm:gap-2 min-w-0 max-w-full">
                {i > 0 && <span class="text-[#6B7280] font-semibold">/</span>}
                {i === breadcrumbs.length - 1 ? (
                  <span class="text-[var(--color-primary)] font-bold truncate max-w-full">{crumb.label}</span>
                ) : (
                  <a href={crumb.href} class="text-[#6B7280] hover:text-[var(--color-primary)] transition-colors truncate max-w-full">{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-dark-navy)] mb-4">{title}</h1>
        {subtitle && <p class="text-lg text-[var(--color-dark-navy)]/70">{subtitle}</p>}
      </div>
    </div>
  </main>
  <MapSection src={mapSrc} title={mapTitle} />
  <Footer />
</Base>

<style>
  .service-placeholder {
    min-block-size: max(28rem, calc(100svh - var(--site-header-h)));
  }

  .service-placeholder-desktop {
    min-block-size: max(28rem, calc(100svh - var(--site-header-h)));
    padding-block: var(--section-space);
  }

  .service-breadcrumb {
    max-inline-size: 100%;
  }

  .service-breadcrumb a,
  .service-breadcrumb span {
    min-inline-size: 0;
    max-inline-size: min(100%, 34rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
