---
interface Props {
  title: string;
  description: string;
  image: string;
  icon: string;
  href: string;
}

const { title, description, image, icon, href } = Astro.props;
---

<a href={href} class="group relative flex flex-col h-80 md:h-96 w-full overflow-hidden rounded-2xl bg-dark-navy shadow-lg transition-transform hover:-translate-y-1 hover:shadow-premium duration-300">
  <!-- Background Image -->
  <div class="absolute inset-0 w-full h-full">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>

  <!-- Gradient Overlay (Dark bottom -> Transparent top) -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#041121] via-[#041121]/80 to-transparent"></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col justify-end h-full p-6 sm:p-8">
    <div class="flex items-center gap-4 mb-3">
      <!-- Icon Container -->
      <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary/90 text-white shadow-md">
        <Fragment set:html={icon} />
      </div>
      <h3 class="text-xl font-semibold text-white tracking-tight">{title}</h3>
    </div>
    
    <p class="text-text-secondary text-sm md:text-base leading-relaxed mb-4 pl-[3.5rem]">
      {description}
    </p>

    <div class="pl-[3.5rem]">
      <span class="inline-flex items-center gap-1.5 text-white font-medium text-sm transition-colors group-hover:text-primary">
        Learn More
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
    </div>
  </div>
</a>
