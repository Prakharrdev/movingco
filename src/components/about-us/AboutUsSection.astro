---
---

<section class="flex flex-col lg:flex-row w-full bg-white">
  <!-- Left Side: Image -->
  <div class="w-full lg:w-2/3 h-[50vh] lg:h-auto min-h-[400px] lg:min-h-[700px]">
    <img 
      src="/images/about us/hero-img.png" 
      alt="Professional moving company crew unloading" 
      class="w-full h-full object-cover object-center"
    />
  </div>

  <!-- Right Side: Content -->
  <div class="w-full lg:w-1/3 flex flex-col justify-center px-8 lg:px-10 xl:px-12 py-16 lg:py-20">
    <div class="max-w-[600px]">
      
      <!-- Section Header -->
      <div class="mb-4">
        <h3 class="text-[#D36A44] font-bold text-sm tracking-[0.15em] uppercase mb-3">Our Story</h3>
        <div class="h-[2px] w-[40px] bg-[#D36A44]"></div>
      </div>
      
      <h2 class="text-[clamp(2.5rem,1.5rem+3vw,3.5rem)] font-extrabold text-[#0a1e3f] leading-[1.15] mb-8">
        Built on Integrity.<br/>Focused on People.
      </h2>
      
      <!-- Paragraphs -->
      <div class="space-y-6 text-[#334155] text-[clamp(1.125rem,1rem+0.5vw,1.375rem)] mb-10 leading-relaxed font-medium">
        <p>
          Ascension Moving was founded with a simple belief &ndash; every move matters.
        </p>
        <p>
          We're a locally owned and operated moving company proudly serving Northern Michigan with honesty, hard work, and a commitment to doing things the right way.
        </p>
        <p>
          From small residential moves to large relocations, we treat every customer like family and every home like our own.
        </p>
      </div>

      <!-- Divider -->
      <hr class="border-t-[1.5px] border-[#E2E8F0] w-full mb-8" />

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        
        <!-- Stat 1 -->
        <div class="flex flex-col items-center text-center">
          <svg class="w-7 h-7 text-[#0a1e3f] mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span class="text-[clamp(1.875rem,1.5rem+1.5vw,2.5rem)] font-extrabold text-[#0a1e3f] mb-2 tracking-tight">10+</span>
          <span class="text-[clamp(0.75rem,0.6rem+0.3vw,0.95rem)] font-bold text-[#D36A44] uppercase tracking-wide leading-[1.3]">Years of<br/>Experience</span>
        </div>

        <!-- Stat 2 -->
        <div class="flex flex-col items-center text-center">
          <svg class="w-7 h-7 text-[#0a1e3f] mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span class="text-[clamp(1.875rem,1.5rem+1.5vw,2.5rem)] font-extrabold text-[#0a1e3f] mb-2 tracking-tight">5,000+</span>
          <span class="text-[clamp(0.75rem,0.6rem+0.3vw,0.95rem)] font-bold text-[#D36A44] uppercase tracking-wide leading-[1.3]">Successful<br/>Moves</span>
        </div>

        <!-- Stat 3 -->
        <div class="flex flex-col items-center text-center">
          <svg class="w-7 h-7 text-[#0a1e3f] mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 00-3-3.87"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 010 7.75"></path>
          </svg>
          <span class="text-[clamp(1.875rem,1.5rem+1.5vw,2.5rem)] font-extrabold text-[#0a1e3f] mb-2 tracking-tight">98%</span>
          <span class="text-[clamp(0.75rem,0.6rem+0.3vw,0.95rem)] font-bold text-[#D36A44] uppercase tracking-wide leading-[1.3]">Customer<br/>Satisfaction</span>
        </div>

        <!-- Stat 4 -->
        <div class="flex flex-col items-center text-center">
          <svg class="w-7 h-7 text-[#0a1e3f] mb-[18px]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10c0 7.142-7.5 11.25-7.5 11.25S4.5 17.142 4.5 10a7.5 7.5 0 1115 0z"></path>
          </svg>
          <!-- Using margin top to align text with the other stat texts which are pushed down by the large numbers -->
          <span class="text-[clamp(0.75rem,0.6rem+0.3vw,0.95rem)] font-bold text-[#D36A44] uppercase tracking-wide leading-[1.3] mt-2">Serving<br/>Northern<br/>Michigan</span>
        </div>

      </div>

      <!-- Divider -->
      <hr class="border-t-[1.5px] border-[#E2E8F0] w-full mb-6" />

      <!-- Footer Text -->
      <div>
        <h4 class="text-[#0a1e3f] font-extrabold text-[clamp(1.25rem,1.1rem+0.75vw,1.75rem)] mb-1">Trusted by Families.</h4>
        <p class="text-[#D36A44] font-medium text-[clamp(1.125rem,1rem+0.5vw,1.375rem)]">Proud to Move Michigan Forward.</p>
      </div>
      
    </div>
  </div>
</section>
