---
---

<div class="flex flex-col w-full bg-white">
  <section class="about-story flex flex-col lg:flex-row w-full relative">
    <!-- Left Side: Image -->
    <div class="about-story-image hidden lg:block relative">
      <div class="about-story-image-frame lg:sticky w-full">
        <img 
          src="/images/about us/hero-img.png" 
          alt="Professional moving company crew unloading" 
          class="w-full h-full object-cover object-center"
        />
      </div>
    </div>

    <!-- Right Side: Content -->
    <div class="about-story-content w-full flex flex-col justify-center">
      <div class="max-w-[600px]">
        
        <!-- Section Header -->
        <div class="mb-4">
          <h3 class="text-[#D36A44] font-bold text-sm tracking-[0.15em] uppercase mb-3">Our Story</h3>
          <div class="h-[2px] w-[40px] bg-[#D36A44]"></div>
        </div>
        
        <h2 class="text-[clamp(2.5rem,1.5rem+3vw,3.5rem)] font-extrabold text-[#0a1e3f] leading-[1.15] mb-8">
          Built on Integrity.<br/>Focused on People.
        </h2>
        
        <!-- Paragraphs -->
        <div class="space-y-6 text-[#334155] text-[clamp(1.125rem,1rem+0.5vw,1.375rem)] mb-10 leading-relaxed font-medium">
          <p>
            Ascension Moving was founded with a simple belief &ndash; every move matters.
          </p>
          <p>
            We're a locally owned and operated moving company proudly serving Northern Michigan with honesty, hard work, and a commitment to doing things the right way.
          </p>
          <p>
            From small residential moves to large relocations, we treat every customer like family and every home like our own.
          </p>
        </div>

        <!-- Divider -->
        <hr class="border-t-[1.5px] border-[#E2E8F0] w-full mb-8" />

        <!-- Footer Text -->
        <div>
          <h4 class="text-[#0a1e3f] font-extrabold text-[clamp(1.25rem,1.1rem+0.75vw,1.75rem)] mb-1">Trusted by Families.</h4>
          <p class="text-[#D36A44] font-medium text-[clamp(1.125rem,1rem+0.5vw,1.375rem)]">Proud to Move Michigan Forward.</p>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Trust Cards Section -->
  <section class="about-trust w-full bg-[#FAFBFC] border-t border-gray-100 relative z-10 shadow-[0_-10px_40px_rgba(0,0,0,0.02)]">
    <div class="site-container">
      
      <!-- Heading -->
      <div class="flex flex-col items-center justify-center text-center mb-16">
        <div class="flex items-center gap-4 mb-5">
          <div class="h-[1.5px] w-8 md:w-12 bg-[#D36A44]"></div>
          <h3 class="text-[#D36A44] font-bold text-[16px] tracking-[0.2em] uppercase">Why Homeowners Trust Us</h3>
          <div class="h-[1.5px] w-8 md:w-12 bg-[#D36A44]"></div>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-[44px] font-extrabold text-[#0a1e3f] leading-tight">
          Built on Experience. Backed by Results.
        </h2>
      </div>

      <!-- Cards Grid -->
      <div class="about-trust-grid grid gap-6 lg:gap-8">
        
        <!-- Card 1 -->
        <div class="bg-white rounded-[20px] p-8 flex flex-col items-center text-center shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-gray-50 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(0,0,0,0.08)] transition-all duration-300">
          <div class="w-[72px] h-[72px] rounded-full bg-white shadow-[0_4px_20px_rgba(0,0,0,0.08)] flex items-center justify-center mb-6 relative">
            <svg class="w-9 h-9 text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <rect x="7" y="14" width="3" height="3" fill="currentColor"></rect>
              <rect x="14" y="14" width="3" height="3" fill="currentColor"></rect>
            </svg>
          </div>
          <h4 class="text-[40px] font-extrabold text-[#0a1e3f] mb-3 leading-none">10+</h4>
          <hr class="w-8 border-t-[2px] border-[#D36A44] mb-4" />
          <h5 class="text-[14px] font-bold text-[#D36A44] tracking-[0.1em] uppercase mb-4 leading-snug">Years of<br/>Experience</h5>
          <p class="text-[15px] text-[#475569] leading-relaxed font-medium">A decade of moving families with care and professionalism.</p>
        </div>

        <!-- Card 2 -->
        <div class="bg-white rounded-[20px] p-8 flex flex-col items-center text-center shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-gray-50 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(0,0,0,0.08)] transition-all duration-300">
          <div class="w-[72px] h-[72px] rounded-full bg-white shadow-[0_4px_20px_rgba(0,0,0,0.08)] flex items-center justify-center mb-6 relative">
            <svg class="w-9 h-9 text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
              <polyline stroke-linecap="round" stroke-linejoin="round" points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line stroke-linecap="round" stroke-linejoin="round" x1="12" y1="22.08" x2="12" y2="12"></line>
              <path stroke-linecap="round" stroke-linejoin="round" d="m7.5 4.27 9 5.15" stroke="#D36A44" stroke-width="2.5"></path>
            </svg>
          </div>
          <h4 class="text-[40px] font-extrabold text-[#0a1e3f] mb-3 leading-none">5,000+</h4>
          <hr class="w-8 border-t-[2px] border-[#D36A44] mb-4" />
          <h5 class="text-[14px] font-bold text-[#D36A44] tracking-[0.1em] uppercase mb-4 leading-snug">Successful<br/>Moves</h5>
          <p class="text-[15px] text-[#475569] leading-relaxed font-medium">Thousands of moves completed safely and on time.</p>
        </div>

        <!-- Card 3 -->
        <div class="bg-white rounded-[20px] p-8 flex flex-col items-center text-center shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-gray-50 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(0,0,0,0.08)] transition-all duration-300">
          <div class="w-[72px] h-[72px] rounded-full bg-white shadow-[0_4px_20px_rgba(0,0,0,0.08)] flex items-center justify-center mb-6 relative">
            <div class="absolute -top-[10px] text-[#D36A44]">
              <svg class="w-[22px] h-[22px] fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
            </div>
            <svg class="w-9 h-9 text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 00-3-3.87"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 010 7.75"></path>
            </svg>
          </div>
          <h4 class="text-[40px] font-extrabold text-[#0a1e3f] mb-3 leading-none">98%</h4>
          <hr class="w-8 border-t-[2px] border-[#D36A44] mb-4" />
          <h5 class="text-[14px] font-bold text-[#D36A44] tracking-[0.1em] uppercase mb-4 leading-snug">Customer<br/>Satisfaction</h5>
          <p class="text-[15px] text-[#475569] leading-relaxed font-medium">Our customers love us &ndash; and it shows in our reviews.</p>
        </div>

        <!-- Card 4 -->
        <div class="bg-white rounded-[20px] p-8 flex flex-col items-center text-center shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-gray-50 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(0,0,0,0.08)] transition-all duration-300">
          <div class="w-[72px] h-[72px] rounded-full bg-white shadow-[0_4px_20px_rgba(0,0,0,0.08)] flex items-center justify-center mb-6 relative">
            <svg class="w-9 h-9 text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" stroke="#D36A44" stroke-width="2.5"></path>
            </svg>
          </div>
          <h4 class="text-[20px] leading-tight font-extrabold text-[#0a1e3f] mb-3 uppercase flex items-center h-[40px]">Licensed<br/>& Insured</h4>
          <hr class="w-8 border-t-[2px] border-[#D36A44] mb-4" />
          <h5 class="text-[14px] font-bold text-[#D36A44] tracking-[0.1em] uppercase mb-4 leading-snug">Your Belongings<br/>Are Protected</h5>
          <p class="text-[15px] text-[#475569] leading-relaxed font-medium">Fully licensed and insured for your peace of mind every step of the way.</p>
        </div>

      </div>
    </div>
  </section>
</div>

<style>
  .about-story {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
  }

  .about-story-image {
    min-inline-size: 0;
  }

  .about-story-image-frame {
    top: var(--navbar-h-scrolled);
    block-size: max(25rem, calc(100svh - var(--navbar-h-scrolled)));
    min-block-size: 25rem;
  }

  .about-story-content {
    min-inline-size: 0;
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    padding-block: var(--section-space-compact);
  }

  .about-trust {
    padding-block: var(--section-space);
  }

  .about-trust-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  @media (max-width: 63.999rem) {
    .about-story {
      display: block;
    }
  }
</style>
