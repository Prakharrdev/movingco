---
---

<section class="process-section flex flex-col lg:flex-row-reverse w-full bg-[#F4F7FB]">
  <!-- Left Side: Image -->
  <div class="process-image-column w-full relative">
    <div class="process-image-frame lg:sticky w-full">
      <img 
        src="/images/about us/about.png" 
        alt="Professional movers in action inside a home" 
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- Right Side: Content -->
  <div class="process-content w-full flex flex-col justify-center bg-[#F4F7FB]">
    
    <!-- Header -->
    <div class="max-w-[800px] w-full mx-auto text-center mb-16">
      <h2 class="text-[clamp(2rem,2.5vw+1rem,3rem)] font-extrabold text-[#0a1e3f] tracking-tight mb-4 uppercase">
        Our Moving Process
      </h2>
      <div class="h-[2px] w-[60px] bg-[#D36A44] mx-auto mb-6"></div>
      <p class="text-[clamp(1rem,1vw+0.5rem,1.25rem)] text-[#4B5563] font-medium max-w-[500px] mx-auto leading-relaxed">
        We make moving simple and stress-free with a proven process you can trust.
      </p>
    </div>
    
    <!-- 5 Steps Process Flow -->
    <div class="process-steps items-start w-full max-w-[1000px] mx-auto relative">
      
      <!-- Step 1 -->
      <div class="process-step flex flex-col items-center text-center">
        <div class="relative mb-5">
          <div class="w-20 h-20 md:w-[90px] md:h-[90px] xl:w-[110px] xl:h-[110px] rounded-full border-[2.5px] border-[#0a1e3f] flex items-center justify-center bg-[#F4F7FB] z-10 relative shadow-sm">
            <!-- Clipboard Icon -->
            <svg class="w-10 h-10 md:w-12 md:h-12 xl:w-[50px] xl:h-[50px] text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <div class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-[#D36A44] text-white flex items-center justify-center text-[13px] xl:text-[15px] font-bold z-20 shadow-sm border-[3px] border-[#F4F7FB]">
            1
          </div>
        </div>
        <h4 class="text-[#0a1e3f] font-extrabold text-[13px] md:text-[15px] xl:text-[17px] uppercase tracking-wide mb-3 mt-4 leading-tight md:min-h-[3rem] flex items-center justify-center">
          REQUEST<br class="hidden md:block" /> A QUOTE
        </h4>
        <p class="text-[#64748B] text-[14px] md:text-[15px] xl:text-[17px] leading-relaxed font-medium px-1 xl:px-3 mt-1">
          Tell us about your move and get a fast, transparent estimate.
        </p>
      </div>

      <!-- Arrow 1 -->
      <div class="hidden xl:flex items-center justify-center mt-12 text-[#94A3B8] flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </div>

      <!-- Step 2 -->
      <div class="process-step flex flex-col items-center text-center">
        <div class="relative mb-5">
          <div class="w-20 h-20 md:w-[90px] md:h-[90px] xl:w-[110px] xl:h-[110px] rounded-full border-[2.5px] border-[#0a1e3f] flex items-center justify-center bg-[#F4F7FB] z-10 relative shadow-sm">
            <!-- Calendar Icon -->
            <svg class="w-10 h-10 md:w-12 md:h-12 xl:w-[50px] xl:h-[50px] text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-[#D36A44] text-white flex items-center justify-center text-[13px] xl:text-[15px] font-bold z-20 shadow-sm border-[3px] border-[#F4F7FB]">
            2
          </div>
        </div>
        <h4 class="text-[#0a1e3f] font-extrabold text-[13px] md:text-[15px] xl:text-[17px] uppercase tracking-wide mb-3 mt-4 leading-tight md:min-h-[3rem] flex items-center justify-center">
          SCHEDULE<br class="hidden md:block" /> YOUR MOVE
        </h4>
        <p class="text-[#64748B] text-[14px] md:text-[15px] xl:text-[17px] leading-relaxed font-medium px-1 xl:px-3 mt-1">
          Pick a date that works for you. We'll take care of the rest.
        </p>
      </div>

      <!-- Arrow 2 -->
      <div class="hidden xl:flex items-center justify-center mt-12 text-[#94A3B8] flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </div>

      <!-- Step 3 -->
      <div class="process-step flex flex-col items-center text-center">
        <div class="relative mb-5">
          <div class="w-20 h-20 md:w-[90px] md:h-[90px] xl:w-[110px] xl:h-[110px] rounded-full border-[2.5px] border-[#0a1e3f] flex items-center justify-center bg-[#F4F7FB] z-10 relative shadow-sm">
            <!-- Box Icon -->
            <svg class="w-10 h-10 md:w-12 md:h-12 xl:w-[50px] xl:h-[50px] text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke-linecap="round" stroke-linejoin="round"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12" stroke-linecap="round" stroke-linejoin="round"></line>
            </svg>
          </div>
          <div class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-[#D36A44] text-white flex items-center justify-center text-[13px] xl:text-[15px] font-bold z-20 shadow-sm border-[3px] border-[#F4F7FB]">
            3
          </div>
        </div>
        <h4 class="text-[#0a1e3f] font-extrabold text-[13px] md:text-[15px] xl:text-[17px] uppercase tracking-wide mb-3 mt-4 leading-tight md:min-h-[3rem] flex items-center justify-center">
          PACK &<br class="hidden md:block" /> PREPARE
        </h4>
        <p class="text-[#64748B] text-[14px] md:text-[15px] xl:text-[17px] leading-relaxed font-medium px-1 xl:px-3 mt-1">
          We carefully pack and protect your belongings with quality materials.
        </p>
      </div>

      <!-- Arrow 3 -->
      <div class="hidden xl:flex items-center justify-center mt-12 text-[#94A3B8] flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </div>

      <!-- Step 4 -->
      <div class="process-step flex flex-col items-center text-center">
        <div class="relative mb-5">
          <div class="w-20 h-20 md:w-[90px] md:h-[90px] xl:w-[110px] xl:h-[110px] rounded-full border-[2.5px] border-[#0a1e3f] flex items-center justify-center bg-[#F4F7FB] z-10 relative shadow-sm">
            <!-- Truck Icon -->
            <svg class="w-10 h-10 md:w-12 md:h-12 xl:w-[50px] xl:h-[50px] text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="5" width="14" height="13" rx="1" stroke-linecap="round" stroke-linejoin="round"></rect>
              <path d="M16 8h2.5a2 2 0 0 1 1.7 1l2.8 4v5h-7" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="6.5" cy="18.5" r="2.5" stroke-linecap="round" stroke-linejoin="round"></circle>
              <circle cx="18.5" cy="18.5" r="2.5" stroke-linecap="round" stroke-linejoin="round"></circle>
            </svg>
          </div>
          <div class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-[#D36A44] text-white flex items-center justify-center text-[13px] xl:text-[15px] font-bold z-20 shadow-sm border-[3px] border-[#F4F7FB]">
            4
          </div>
        </div>
        <h4 class="text-[#0a1e3f] font-extrabold text-[13px] md:text-[15px] xl:text-[17px] uppercase tracking-wide mb-3 mt-4 leading-tight md:min-h-[3rem] flex items-center justify-center">
          TRANSPORT<br class="hidden md:block" /> SAFELY
        </h4>
        <p class="text-[#64748B] text-[14px] md:text-[15px] xl:text-[17px] leading-relaxed font-medium px-1 xl:px-3 mt-1">
          Your items are loaded, secured, and transported with care.
        </p>
      </div>

      <!-- Arrow 4 -->
      <div class="hidden xl:flex items-center justify-center mt-12 text-[#94A3B8] flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </div>

      <!-- Step 5 -->
      <div class="process-step flex flex-col items-center text-center">
        <div class="relative mb-5">
          <div class="w-20 h-20 md:w-[90px] md:h-[90px] xl:w-[110px] xl:h-[110px] rounded-full border-[2.5px] border-[#0a1e3f] flex items-center justify-center bg-[#F4F7FB] z-10 relative shadow-sm">
            <!-- House Icon -->
            <svg class="w-10 h-10 md:w-12 md:h-12 xl:w-[50px] xl:h-[50px] text-[#0a1e3f]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <div class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-[#D36A44] text-white flex items-center justify-center text-[13px] xl:text-[15px] font-bold z-20 shadow-sm border-[3px] border-[#F4F7FB]">
            5
          </div>
        </div>
        <h4 class="text-[#0a1e3f] font-extrabold text-[13px] md:text-[15px] xl:text-[17px] uppercase tracking-wide mb-3 mt-4 leading-tight md:min-h-[3rem] flex items-center justify-center">
          DELIVER &<br class="hidden md:block" /> SETTLE IN
        </h4>
        <p class="text-[#64748B] text-[14px] md:text-[15px] xl:text-[17px] leading-relaxed font-medium px-1 xl:px-3 mt-1">
          We unload and place everything where you want it. Home, sweet home.
        </p>
      </div>

    </div>

    <!-- Footer -->
    <div class="mt-16 text-center">
      <p class="text-[clamp(1.1rem,1vw+0.5rem,1.25rem)] text-[#0a1e3f] font-extrabold mb-1 tracking-tight">
        From start to finish, we're with you every step of the way.
      </p>
      <p class="text-[clamp(1.1rem,1vw+0.5rem,1.25rem)] text-[#D36A44] font-black uppercase tracking-[0.1em]">
        MOVING MADE SIMPLE.
      </p>
    </div>

  </div>
</section>

<style>
  .process-section {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .process-image-column {
    min-inline-size: 0;
    grid-column: 2;
    grid-row: 1;
  }

  .process-image-frame {
    top: var(--navbar-h-scrolled);
    block-size: max(25rem, calc(100svh - var(--navbar-h-scrolled)));
    min-block-size: 25rem;
  }

  .process-content {
    min-inline-size: 0;
    grid-column: 1;
    grid-row: 1;
    padding-inline: clamp(1.5rem, 4vw, 5rem);
    padding-block: var(--section-space);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 2vw, 1.5rem);
  }

  .process-step {
    min-inline-size: 0;
  }

  @media (min-width: 64rem) {
    .process-image-column {
      inline-size: auto;
    }

    .process-content {
      inline-size: auto;
    }
  }

  @media (min-width: 75rem) {
    .process-steps {
      display: flex;
      justify-content: space-between;
      gap: clamp(0.5rem, 1vw, 1rem);
    }

    .process-step {
      flex: 1 1 0;
    }
  }

  @media (max-width: 63.999rem) {
    .process-section {
      display: block;
    }

    .process-image-column,
    .process-content {
      inline-size: 100%;
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
