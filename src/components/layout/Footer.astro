---
const serviceAreas = [
  "Traverse City",
  "Cadillac",
  "Kalkaska",
  "Charlevoix",
  "Petoskey",
  "Frankfort",
  "Gaylord",
  "Manistee"
];

const hours = [
  { day: "Mon – Fri", time: "9:00 AM – 5:00 PM" },
  { day: "Saturday", time: "9:00 AM – 5:00 PM" },
  { day: "Sunday", time: "9:00 AM – 5:00 PM" }
];
---

<footer class="footer-main">
  <div class="site-container">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Logo & Social -->
      <div>
        <div class="flex items-center gap-3 text-white font-bold tracking-tight mb-4">
          <img src="/images/Logo/logo.png" alt="Ascension Moving Company" class="w-[86px] h-[86px] rounded-full object-cover" />
          <span class="flex flex-col">
            <span class="text-2xl leading-none mb-1">ASCENSION</span>
            <span class="text-[11px] tracking-[0.2em] text-primary uppercase leading-none mb-1 font-black">Moving Company</span>
            <span class="text-[9px] tracking-[0.1em] text-white/90">YOUR MOVE, YOUR WAY!</span>
          </span>
        </div>
        <p class="mb-5 text-white/75 text-[15px] leading-relaxed">
          Providing premium residential & commercial moving services across Traverse City and surrounding Northern Michigan counties.
        </p>
        <div class="flex gap-2">
          <a href="https://www.google.com/maps/place/Ascension+Moving+Company+LLC/@45.0204126,-86.266099,9z/data=!4m8!3m7!1s0x401408a8c52c06af:0x334a9d60143b9213!8m2!3d45.0223094!4d-85.606771!9m1!1b1!16s%2Fg%2F11vxhkbzvf" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Review us on Google">
            <svg viewBox="0 0 24 24" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#fff"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#fff"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#fff"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#fff"/>
            </svg>
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Find us on Facebook">
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Contact Info -->
      <div>
        <h5 class="footer-heading">Contact Us</h5>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Company:</span> Ascension Moving, LLC.
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Phone:</span>
          <a href="tel:+12313429505" class="font-semibold text-white hover:text-primary transition-colors">(231) 342-9505</a>
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Service Area:</span> Traverse City, MI
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Established:</span> 2020
        </div>
      </div>

      <!-- Location & Hours -->
      <div>
        <h5 class="footer-heading">Address & Hours</h5>
        <div class="footer-contact-item mb-3">
          <span class="footer-contact-label">Office Address:</span><br />
          Traverse City, MI 49686
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Business Hours:</span>
        </div>
        <ul class="business-hours mt-1">
          {hours.map((h) => (
            <li><span>{h.day}</span><span>{h.time}</span></li>
          ))}
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h5 class="footer-heading">Communities We Serve</h5>
        <ul class="footer-list mt-3">
          {serviceAreas.map((area) => (
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary inline-block mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              {area}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>

  <div class="copyright-bar">
    <div class="site-container flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">
      <p class="mb-0 text-[15px]">Copyright &copy; 2026 Ascension Moving, LLC | Website by <a href="https://schrader.co/" target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-primary transition-colors">Schrader Web Solutions</a></p>
      <p class="mb-0 text-[15px]">
        <a href="#" class="hover:text-primary transition-colors">Privacy Policy</a>
        <span class="mx-1">|</span>
        <a href="#" class="hover:text-primary transition-colors">Terms & Conditions</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-main {
    background-color: var(--color-dark-navy);
    color: rgba(255, 255, 255, 0.75);
    padding-block-start: var(--section-space-compact);
    font-family: var(--font-sans);
  }

  .footer-main p {
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-heading {
    font-size: clamp(1rem, calc(0.9rem + 0.35vw), 1.15rem);
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    position: relative;
    padding-block-end: clamp(0.4rem, 0.8vw, 0.5rem);
    margin-block-end: clamp(0.875rem, 1.5vw, 1.125rem);
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(1.75rem, 3vw, 2rem);
    height: 0.15625rem;
    background-color: var(--color-primary);
  }

  .footer-contact-item {
    margin-block-end: clamp(0.5rem, 1vw, 0.625rem);
    line-height: 1.6;
    font-size: clamp(0.9rem, calc(0.84rem + 0.2vw), 0.98rem);
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-contact-label {
    font-weight: 600;
    color: #fff;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-list li {
    margin-block-end: clamp(0.4rem, 0.8vw, 0.5rem);
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(0.875rem, calc(0.82rem + 0.2vw), 0.95rem);
  }

  .business-hours {
    list-style: none;
    margin: 0;
    padding: 0;
    max-inline-size: min(100%, 20rem);
  }

  .business-hours li {
    display: flex;
    justify-content: space-between;
    gap: clamp(0.35rem, 1vw, 0.5rem);
    margin-block-end: clamp(0.5rem, 1vw, 0.625rem);
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(0.875rem, calc(0.82rem + 0.2vw), 0.95rem);
  }

  .footer-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.5rem, 4vw, 2.625rem);
    height: clamp(2.5rem, 4vw, 2.625rem);
    background-color: var(--color-secondary-navy);
    color: #fff;
    border-radius: 50%;
    transition: transform 0.2s, background-color 0.2s;
    text-decoration: none;
  }

  .footer-social-btn:hover {
    transform: translateY(-2px);
    background-color: var(--color-primary);
  }

  .copyright-bar {
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
    background-color: rgba(0, 0, 0, 0.35);
    color: rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-block: clamp(1rem, 2vw, 1.125rem);
  }

  .copyright-bar a {
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 39.999rem) {
    .business-hours li {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
