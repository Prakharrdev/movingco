      <span class="text-[10px] md:text-[12px] tracking-[0.2em] text-[var(--color-primary)] uppercase leading-none mb-1 font-black">Moving Company</span>
      <span class="text-[8px] md:text-[9px] tracking-[0.1em] text-white/90">YOUR MOVE, YOUR WAY!</span>
    </div>

    <!-- Links -->
    <div class="hidden lg:flex items-center gap-6 xl:gap-8 text-[15px] font-bold text-white pt-2 lg:pr-48 xl:pr-64">
