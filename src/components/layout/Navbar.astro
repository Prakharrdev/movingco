        </a>
        <div class="absolute left-0 top-full pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <div class="bg-[var(--color-dark-navy)] border border-white/10 rounded-md shadow-2xl py-2 w-64">
            <a href="/services/arts-antiques" class="block px-5 py-2.5 text-white/90 hover:text-white hover:bg-[var(--color-primary)]/20 transition-colors text-[14px] font-semibold">Arts & Antiques</a>
            <a href="/services/local-distance-moving" class="block px-5 py-2.5 text-white/90 hover:text-white hover:bg-[var(--color-primary)]/20 transition-colors text-[14px] font-semibold">Local & Distance Moving</a>
            <a href="/services/packing-unpacking" class="block px-5 py-2.5 text-white/90 hover:text-white hover:bg-[var(--color-primary)]/20 transition-colors text-[14px] font-semibold">Packing & Unpacking</a>
