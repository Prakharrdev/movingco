---
import Button from '../ui/Button.astro';
---

<nav class="absolute top-8 left-1/2 w-[calc(100%-48px)] max-w-[1376px] z-50 animate-fade-down opacity-0">
  <div class="h-[80px] rounded-full bg-white/10 backdrop-blur-lg border border-[var(--color-border-glass)] px-6 md:px-8 flex items-center justify-between shadow-lg">
    <div class="flex items-center gap-3 cursor-pointer">
      <!-- Placeholder Logo -->
      <div class="w-10 h-10 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white font-bold text-lg">A</div>
      <span class="text-white font-bold text-xl tracking-tight hidden sm:block">Ascension</span>
    </div>
    
    <div class="hidden lg:flex items-center gap-8 text-[16px] font-semibold text-white/90">
      <a href="#" class="hover:text-white transition-colors">Home</a>
      <a href="#" class="hover:text-white transition-colors">Services</a>
      <a href="#" class="hover:text-white transition-colors">About</a>
      <a href="#" class="hover:text-white transition-colors">Reviews</a>
      <a href="#" class="hover:text-white transition-colors">Contact</a>
    </div>

    <div class="hidden md:block">
      <Button variant="primary" class="!py-3 !px-6 !rounded-full !text-sm">
        (800) 123-4567
      </Button>
    </div>

    <button class="lg:hidden text-white p-2 focus:outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>
</nav>
