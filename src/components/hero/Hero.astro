---
import HeroBackground from './HeroBackground.astro';
import HeroContent from './HeroContent.astro';
import QuoteCard from './QuoteCard.astro';
import HeroWave from '../shared/HeroWave.astro';
---

<section class="hero-section relative w-full flex flex-col justify-center overflow-hidden bg-[var(--color-dark-navy)]">
  <HeroBackground />
  
  <!-- Container -->
  <div class="site-container hero-container relative z-10 flex-grow flex items-center">
    
    <div class="hero-layout w-full">
      
      <!-- Left Content -->
      <div class="hero-content-column w-full">
        <HeroContent />
      </div>
      
      <!-- Right Content (Form) -->
      <div class="hero-form-column w-full flex items-center justify-center lg:justify-end relative z-10">
        <div class="w-full">
          <QuoteCard />
        </div>
      </div>
      
    </div>
    
  </div>

  <HeroWave fill="blue-light" />
</section>

<style>
  .hero-section {
    min-block-size: max(36rem, 80svh);
  }

  .hero-container {
    min-block-size: calc(max(36rem, 80svh) - var(--site-header-h));
    padding-block-start: calc(var(--site-header-h) + clamp(1.5rem, 3vw, 2.5rem));
    padding-block-end: var(--section-space-compact);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(min(100%, 30rem), 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    margin-block-start: clamp(0rem, 2vw, 3rem);
  }

  .hero-content-column,
  .hero-form-column {
    min-inline-size: 0;
  }

  @media (max-width: 63.999rem) {
    .hero-layout {
      grid-template-columns: minmax(0, 1fr);
      margin-block-start: 0;
    }

    .hero-form-column {
      justify-content: center;
    }
  }
</style>
