---
import HeroBackground from './HeroBackground.astro';
import HeroContent from './HeroContent.astro';
import QuoteCard from './QuoteCard.astro';
import WaveDivider from './WaveDivider.astro';
---

<section class="relative w-full min-h-[100svh] flex flex-col justify-center overflow-hidden bg-[var(--color-dark-navy)]">
  <HeroBackground />
  
  <!-- Container -->
  <div class="relative w-full max-w-[1440px] mx-auto px-4 md:px-8 pt-[120px] pb-32 z-10 flex-grow flex items-center">
    
    <div class="w-full grid grid-cols-1 lg:grid-cols-[55%_45%] xl:grid-cols-[60%_40%] gap-12 lg:gap-8 items-center">
      
      <!-- Left Content -->
      <HeroContent />
      
      <!-- Right Content (Form) -->
      <div class="w-full h-full flex items-center justify-center lg:justify-end relative z-10 pb-20 lg:pb-0">
        <QuoteCard />
      </div>
      
    </div>
    
  </div>

  <WaveDivider />
</section>
