---
import HeroBackground from './HeroBackground.astro';
import HeroContent from './HeroContent.astro';
import QuoteCard from './QuoteCard.astro';
import HeroWave from '../shared/HeroWave.astro';
---

<section class="relative w-full min-h-[80svh] flex flex-col justify-center overflow-hidden bg-[var(--color-dark-navy)]">
  <HeroBackground />
  
  <!-- Container -->
  <div class="relative w-full max-w-[1440px] mx-auto px-6 md:px-12 lg:px-20 pt-[calc(var(--navbar-h)+40px)] pb-16 md:pb-24 z-10 flex-grow flex items-center min-h-[calc(80svh-var(--navbar-h))]">
    
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-6 xl:gap-16 w-full mt-12 lg:mt-0">
      
      <!-- Left Content -->
      <div class="w-full lg:w-[55%] flex-shrink-0">
        <HeroContent />
      </div>
      
      <!-- Right Content (Form) -->
      <div class="w-full lg:w-[45%] xl:w-[40%] flex items-center justify-center lg:justify-end relative z-10">
        <div class="w-full max-w-[480px]">
          <QuoteCard />
        </div>
      </div>
      
    </div>
    
  </div>

  <HeroWave fill="blue-light" />
</section>
