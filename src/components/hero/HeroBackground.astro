<div class="absolute inset-0 w-full h-full z-0 overflow-hidden bg-slate-800">
  <!-- Background Image Layer -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-60" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');"></div>
  
  <!-- Dark Navy Overlay -->
  <div class="absolute inset-0 bg-[var(--color-dark-navy)]/80 mix-blend-multiply"></div>
  
  <!-- Blue Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-dark-navy)] via-[var(--color-primary)]/20 to-transparent"></div>
</div>
