---
import TrustGrid from './TrustGrid.astro';
---

<div class="flex flex-col items-start text-left max-w-xl xl:max-w-2xl relative z-10 pt-32 pb-10 lg:pb-20">
  
  <h1 class="text-[40px] md:text-[56px] xl:text-[64px] font-[800] text-white leading-[1.1] tracking-[-0.02em] mb-6">
    Professional Moving<br />Services in <br class="hidden sm:block" />
    <span class="text-[var(--color-primary)]">Northern Michigan</span>
  </h1>
  
  <p class="text-[20px] font-medium text-white/90 leading-[1.6] max-w-[500px] mb-4">
    Local or long-distance, big or small —<br/>
    we move your life with care.<br/>
    Your Move, Your Way!
  </p>
  
  <TrustGrid />
</div>
