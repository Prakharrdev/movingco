---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import TrustGrid from './TrustGrid.astro';
---

<div class="flex flex-col items-start text-left max-w-xl xl:max-w-2xl relative z-10 pt-20 md:pt-32 pb-10 lg:pb-20">
  <Badge class="mb-6 animate-fade-up opacity-0 [animation-delay:100ms]">
    <span class="text-[var(--color-accent)] mr-2">★★★★★</span> Trusted Since 2020
  </Badge>
  
  <h1 class="text-4xl md:text-5xl xl:text-[72px] font-[800] text-white leading-[1.1] tracking-[-0.02em] mb-6 animate-fade-up opacity-0 [animation-delay:200ms]">
    Professional Moving Services Across <span class="text-[var(--color-accent)]">Northern Michigan</span>
  </h1>
  
  <p class="text-[20px] font-medium text-[var(--color-text-secondary)] leading-[1.6] max-w-[540px] mb-10 animate-fade-up opacity-0 [animation-delay:300ms]">
    Experience a seamless and stress-free move with our dedicated team of professionals. We handle your belongings with the utmost care, ensuring they arrive safely on time.
  </p>
  
  <div class="flex flex-col sm:flex-row gap-4 mb-12 sm:mb-16 w-full sm:w-auto animate-slide-up opacity-0 [animation-delay:400ms]">
    <Button variant="primary" class="w-full sm:w-auto">Get Free Estimate</Button>
    <Button variant="secondary" class="w-full sm:w-auto">Call Now</Button>
  </div>
  
  <TrustGrid />
</div>
