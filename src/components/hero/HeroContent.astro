---
import TrustGrid from './TrustGrid.astro';
---

<div class="flex flex-col items-start text-left max-w-xl xl:max-w-2xl relative z-10 w-full">
  
  <h1 class="text-[clamp(2.25rem,5vw,4rem)] font-[800] text-white leading-[1.1] tracking-[-0.02em] mb-6">
    Professional Moving<br />Services in <br class="hidden sm:block" />
    <span class="text-[var(--color-primary)]">Northern Michigan</span>
  </h1>
  
  <p class="text-base md:text-[20px] font-medium text-white/90 leading-[1.6] max-w-full sm:max-w-[500px] mb-4">
    Local or long-distance, big or small —<br/>
    we move your life with care.<br/>
    Your Move, Your Way!
  </p>
  
  <TrustGrid />
</div>
