---
---

<div class="quote-card bg-[#0b1c31] w-full mx-auto xl:mx-0 rounded-2xl shadow-2xl relative">
  <h3 class="text-xl font-medium text-white mb-6 text-center">
    Get a <br/>
    <span class="text-2xl md:text-[32px] font-bold text-[var(--color-primary)] mt-1 inline-block leading-tight">Free Estimate</span>
  </h3>
  
  <form class="space-y-4" onsubmit="event.preventDefault();">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <input type="text" placeholder="First Name *" class="w-full py-3 px-4 rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
      <input type="text" placeholder="Last Name *" class="w-full py-3 px-4 rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <input type="tel" placeholder="Phone Number *" class="w-full py-3 px-4 rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
      <input type="email" placeholder="Email Address *" class="w-full py-3 px-4 rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
    </div>
    
    <input type="text" placeholder="Zip Code *" class="w-full py-3 px-4 rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
    
    <div class="relative">
      <select class="w-full py-3 px-4 rounded bg-white text-gray-900 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all appearance-none">
        <option value="" disabled selected>Service Needed?</option>
        <option value="residential">Residential Moving</option>
        <option value="commercial">Commercial Moving</option>
      </select>
      <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>

    <div class="relative">
      <select class="w-full py-3 px-4 rounded bg-white text-gray-900 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all appearance-none">
        <option value="" disabled selected>How Did You Hear About Us?</option>
        <option value="google">Google</option>
        <option value="friend">Friend / Referral</option>
      </select>
      <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>
    
    <textarea placeholder="Tell us about your move..." class="w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all resize-none quote-textarea"></textarea>
    
    <button type="submit" class="w-full py-4 bg-[var(--color-primary)] text-white font-bold text-[16px] uppercase tracking-wide rounded mt-2 hover:bg-blue-600 transition-colors">
      GET A QUOTE
    </button>
  </form>
</div>

<style>
  .quote-card {
    max-inline-size: min(100%, 30rem);
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .quote-textarea {
    min-block-size: clamp(6rem, 12vw, 7rem);
    padding: clamp(0.75rem, 1.5vw, 1rem);
  }
</style>
