---
---

<div class="quote-card w-full rounded-[16px] shadow-2xl relative overflow-hidden bg-white flex flex-col">
  
  <div class="p-6 md:p-8 md:pb-6 flex-grow">
    <img src="/images/Logo/Logo.svg" alt="Ascension Moving Company" class="block mx-auto mb-4" width="120" height="120" />
    <h3 class="text-[clamp(1.35rem,2.4vw,1.8rem)] font-extrabold text-[#071C35] mb-5 text-center">
      Get a <span class="text-[var(--color-primary)]">Free Estimate</span>
    </h3>
    
    <form class="quote-form space-y-3.5">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div class="relative">
          <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <input type="text" name="firstName" placeholder="Full Name*" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
        </div>
        <div class="relative">
          <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <input type="text" name="lastName" placeholder="Last Name*" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
        </div>
      </div>
      
      <div class="relative">
        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </div>
        <input type="email" name="email" placeholder="Email Address*" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
      </div>

      <div class="relative">
        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <input type="tel" name="phone" placeholder="Phone Number*" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
      </div>

      <div class="relative">
        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <input type="text" name="movingFrom" placeholder="Moving From*" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
      </div>

      <div class="relative">
        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <input type="text" name="movingTo" placeholder="Moving To*" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
      </div>
      
      <div class="relative">
        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500 z-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <select name="serviceNeeded" class="hero-form-control w-full rounded bg-white text-gray-900 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all appearance-none pl-9 relative z-0">
          <option value="" disabled selected>Service Needed?</option>
          <option value="residential">Residential Moving</option>
          <option value="commercial">Commercial Moving</option>
        </select>
        <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-500 z-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
        </div>
        <input type="text" name="preferredDate" onfocus="(this.type='date')" onblur="(this.type='text')" placeholder="Preferred Moving Date" class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all pl-9" />
      </div>
      
      <div class="relative">
        <div class="absolute top-[0.85rem] left-3 flex items-center pointer-events-none text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
        </div>
        <textarea name="moveDetails" placeholder="Tell us about your move..." class="hero-form-control w-full rounded bg-white text-gray-900 placeholder:text-gray-500 text-[14px] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all resize-none quote-textarea pl-9"></textarea>
      </div>
      
      <button type="submit" class="quote-submit w-full py-[0.875rem] bg-[#e87516] text-white font-bold text-[15px] uppercase tracking-wide rounded mt-2 hover:bg-[#d8650c] transition-colors shadow-sm">
        GET A QUOTE
      </button>
      <p class="quote-form-status hidden text-center text-[13px] font-medium mt-1"></p>
    </form>
  </div>

  <!-- Bottom Trust Bar -->
  <div class="bg-[#071C35] p-4 text-white">
    <div class="grid grid-cols-3 gap-2">
      <div class="flex flex-col items-center text-center">
        <div class="w-6 h-6 text-[#2E7CCB] flex items-center justify-center mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-wider text-white">No Hidden Fees</span>
      </div>
      <div class="flex flex-col items-center text-center border-l border-white/20">
        <div class="w-6 h-6 text-[#2E7CCB] flex items-center justify-center mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-wider text-white">Quick Response</span>
      </div>
      <div class="flex flex-col items-center text-center border-l border-white/20">
        <div class="w-6 h-6 text-[#2E7CCB] flex items-center justify-center mb-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
        </div>
        <span class="text-[10px] md:text-[11px] font-bold uppercase tracking-wider text-white">100% Satisfaction</span>
      </div>
    </div>
  </div>

</div>

<style>
  .quote-card {
    max-inline-size: min(100%, 30rem);
  }

  .hero-form-control {
    min-block-size: clamp(2.5rem, 4vw, 2.75rem);
    padding-block: clamp(0.5rem, 1vw, 0.75rem);
    padding-inline-end: clamp(0.75rem, 1.2vw, 1rem);
    padding-left: 2.5rem; /* Ensure space for left icons */
    border: 1px solid rgb(100 116 139 / 28%);
  }

  .quote-textarea {
    min-block-size: clamp(4.5rem, 8vw, 5.5rem);
    padding-block: clamp(0.75rem, 1.5vw, 1rem);
  }
</style>

<script>
  const form = document.querySelector('.quote-form');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const button = form.querySelector('.quote-submit');
    const status = form.querySelector('.quote-form-status');
    const originalLabel = button.textContent;

    button.disabled = true;
    button.textContent = 'Sending...';
    status.classList.add('hidden');

    try {
      const payload = Object.fromEntries(new FormData(form).entries());
      const response = await fetch('/api/send-quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        throw new Error(data.error || 'Request failed');
      }

      form.innerHTML =
        '<div class="text-center py-8">' +
        '<h4 class="font-bold text-[22px] text-[var(--color-primary)] mb-2">Thank You!</h4>' +
        "<p class='text-gray-500 text-[15px]'>Your quote request has been sent. We'll get back to you shortly.</p>" +
        '</div>';
    } catch (error) {
      button.disabled = false;
      button.textContent = originalLabel;
      status.textContent = error.message || 'Something went wrong. Please try again.';
      status.classList.remove('hidden');
      status.style.color = '#dc2626';
    }
  });
</script>
