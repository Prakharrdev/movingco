        </svg>
      </div>
      <div class="flex items-center gap-1">
        <!-- 5 Stars -->
        <div class="flex text-[#FBBC05]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <span class="text-[#071C35] font-extrabold text-sm leading-none mt-[2px]">4.9</span>
      </div>
    </div>
  </div>

  <!-- Review Count -->
  <div class="flex flex-col">
    <span class="text-[1.125rem] font-extrabold text-[#071C35] leading-none mb-1">100+</span>
    <span class="text-[#17263d] text-[11px] uppercase tracking-wider font-bold">5-Star Reviews</span>
  </div>

  <!-- Licensed & Insured -->
  <div class="flex flex-col">
    <span class="text-[1.125rem] font-extrabold text-[#071C35] leading-none mb-1">Licensed</span>
    <span class="text-[#17263d] text-[11px] uppercase tracking-wider font-bold">& Insured</span>
  </div>

</div>
