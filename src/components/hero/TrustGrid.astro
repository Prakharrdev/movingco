<div class="trust-column w-full flex flex-col items-start border-t border-[rgb(7,28,53,0.15)] pt-6 gap-5 relative z-20 pb-4">
  
  <!-- Google Reviews -->
  <div class="flex items-center gap-3">
    <div class="flex flex-col">
      <div class="flex items-center gap-1 mb-1">
        <!-- Google Logo SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28">
          <path fill="#4285F4" d="M23.7449 12.27C23.7449 11.48 23.6749 10.73 23.5549 10H12.2549V14.51H18.7249C18.4349 15.99 17.5849 17.24 16.3249 18.09V21.09H20.1849C22.4449 19.01 23.7449 15.92 23.7449 12.27Z"/>
          <path fill="#34A853" d="M12.255 24C15.495 24 18.205 22.92 20.185 21.09L16.325 18.09C15.245 18.81 13.875 19.25 12.255 19.25C9.11496 19.25 6.45496 17.14 5.50496 14.29H1.54492V17.38C3.51492 21.3 7.56496 24 12.255 24Z"/>
