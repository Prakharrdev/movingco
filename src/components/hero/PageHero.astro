---
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: string;
  crumbs: Crumb[];
  cta?: { label: string; href: string };
}

const { eyebrow, title, subtitle, image, crumbs, cta } = Astro.props;
---

<section class="w-full bg-white pt-[56px] pb-12 text-[var(--color-dark-navy)]">
  <div class="w-full max-w-[1440px] mx-auto px-6 md:px-12 lg:px-20">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="h-10 flex items-center mb-2">
      <ol class="flex items-center gap-1.5 sm:gap-2 list-none m-0 p-0 text-[clamp(0.65rem,3vw,0.875rem)] leading-tight whitespace-nowrap">
        {crumbs.map((crumb, i) => (
          <li class="flex items-center gap-1.5 sm:gap-2">
            {i > 0 && <span class="text-[#6B7280] font-semibold">/</span>}
            {i === crumbs.length - 1 ? (
              <span class="text-[var(--color-primary)] font-bold truncate">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="text-[#6B7280] hover:text-[var(--color-primary)] transition-colors truncate">{crumb.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Grace-style stacked hero image -->
    <img
      src={image}
      alt={title}
      class="block w-full h-[400px] object-cover object-center rounded-[24px]"
      loading="eager"
    />

    <div class="pt-6">
      {eyebrow && (
        <p class="text-[var(--color-primary)] font-bold text-sm tracking-[0.15em] uppercase mb-3">{eyebrow}</p>
      )}

      <h1 class="text-[clamp(1.75rem,7.2vw,2.25rem)] font-extrabold text-[#171717] leading-[1.2] mb-4">
        {title}
      </h1>

      {subtitle && (
        <p class="text-[clamp(1.125rem,5.1vw,1.25rem)] text-[#6B7280] leading-[1.5] max-w-[560px] mb-6">
          {subtitle}
        </p>
      )}

      {cta && (
        <a
          href={cta.href}
          class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-extrabold text-base px-7 py-4 rounded-[16px] shadow-[0_6px_16px_rgba(46,125,235,0.25)] hover:-translate-y-[2px] hover:shadow-[0_12px_24px_rgba(46,125,235,0.3)] transition-all w-fit"
        >
          {cta.label}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  </div>
</section>
