---
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: string;
  crumbs: Crumb[];
  cta?: { label: string; href: string };
}

const { eyebrow, title, subtitle, image, crumbs, cta } = Astro.props;
---

<section class="page-hero w-full bg-white text-[var(--color-dark-navy)]">
  <div class="site-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="page-hero-breadcrumb flex items-center">
      <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 list-none m-0 p-0 text-[clamp(0.65rem,3vw,0.875rem)] leading-tight">
        {crumbs.map((crumb, i) => (
          <li class="page-hero-crumb flex items-center gap-1.5 sm:gap-2">
            {i > 0 && <span class="text-[#6B7280] font-semibold">/</span>}
            {i === crumbs.length - 1 ? (
              <span class="text-[var(--color-primary)] font-bold truncate">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="text-[#6B7280] hover:text-[var(--color-primary)] transition-colors truncate">{crumb.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Grace-style stacked hero image -->
    <img
      src={image}
      alt={title}
      class="page-hero-image block w-full object-cover object-center rounded-[24px]"
      loading="eager"
    />

    <div class="pt-6">
      {eyebrow && (
        <p class="text-[var(--color-primary)] font-bold text-sm tracking-[0.15em] uppercase mb-3">{eyebrow}</p>
      )}

      <h1 class="text-[clamp(1.75rem,7.2vw,2.25rem)] font-extrabold text-[#171717] leading-[1.2] mb-4">
        {title}
      </h1>

      {subtitle && (
        <p class="page-hero-subtitle text-[clamp(1.125rem,5.1vw,1.25rem)] text-[#6B7280] leading-[1.5] mb-6">
          {subtitle}
        </p>
      )}

      {cta && (
        <a
          href={cta.href}
          class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white font-extrabold text-base px-7 py-4 rounded-[16px] shadow-[0_6px_16px_rgba(46,125,235,0.25)] hover:-translate-y-[2px] hover:shadow-[0_12px_24px_rgba(46,125,235,0.3)] transition-all w-fit"
        >
          {cta.label}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block-start: var(--site-header-h);
    padding-block-end: var(--section-space-compact);
  }

  .page-hero-breadcrumb {
    min-block-size: clamp(2.5rem, 6vw, 3rem);
    margin-block-end: clamp(0.25rem, 1vw, 0.5rem);
  }

  .page-hero-breadcrumb ol,
  .page-hero-crumb {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .page-hero-breadcrumb a,
  .page-hero-breadcrumb span {
    min-inline-size: 0;
    max-inline-size: min(100%, 34rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .page-hero-image {
    height: clamp(14rem, 30vw, 25rem);
  }

  .page-hero-subtitle {
    max-inline-size: min(100%, 35rem);
  }

  @media (max-width: 24rem) {
    .page-hero-breadcrumb ol {
      row-gap: 0.25rem;
    }

    .page-hero-image {
      border-radius: 1rem;
    }
  }
</style>
