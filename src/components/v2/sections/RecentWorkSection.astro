---

<section class="py-24 bg-light-gray">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-16 flex flex-col items-center">
      <!-- Logo -->
      <img src="/images/Logo/logo.png" alt="Ascension Moving Company" class="w-28 h-28 rounded-full object-cover mb-4" />

      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="h-[1px] w-12 bg-dark-navy/20"></div>
        <span class="text-dark-navy font-bold text-[13px] tracking-[0.15em] uppercase">Our Recent Work</span>
        <div class="h-[1px] w-12 bg-dark-navy/20"></div>
      </div>
      
      <h2 class="text-2xl sm:text-[36px] md:text-[48px] font-bold text-dark-navy leading-tight mb-4">
        Built for <span class="text-primary">Every Move.</span> Backed by Experience.
      </h2>
      
      <p class="text-[18px] text-gray-600 font-medium max-w-2xl mx-auto">
        Take a look at some of our recent moves across Northern Michigan.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {recentWorks.map(work => (
        <RecentWorkCard 
          title={work.title}
          location={work.location}
          image={work.image}
          icon={work.icon}
        />
      ))}
    </div>

    <!-- CTA Button -->
    <div class="flex justify-center">
      <a 
        href="/gallery" 
        class="inline-flex items-center justify-center px-8 py-3.5 bg-white border-2 border-primary text-primary font-bold text-[14px] uppercase tracking-wider rounded-[10px] transition-colors duration-300 hover:bg-primary/5 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      >
        View Full Gallery 
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    
  </div>
</section>
