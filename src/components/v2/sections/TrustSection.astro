---
import WaveDivider from '../../shared/WaveDivider.astro';

const communities = [
  "Traverse City", "Kingsley", "Kalkaska", "Cadillac", "Charlevoix", "Petoskey", 
  "Gaylord", "Manistee", "Elk Rapids", "Frankfort",
  "Leland", "Suttons Bay", "Northport", "Empire", "Boyne City", "Harbor Springs", 
  "Interlochen", "Lake Ann", "Beulah", "Onekama", "Benzonia", "Thompsonville"
];
---

<section class="trust-section relative w-full bg-[#F4F8FE] pb-0 overflow-hidden" id="trust-section">
  <!-- Service Area top wave — light-gray flowing into the Trust section bg -->
  <WaveDivider fill="var(--color-light-gray)" position="top" />

  <div class="site-container relative z-10 flex flex-col items-center">
    
    <!-- Heading -->
    <div class="text-center max-w-3xl trust-animate opacity-0 translate-y-6">
      <h2 class="text-[clamp(2rem,4vw,3rem)] font-extrabold text-dark-navy leading-[1.15] tracking-tight">
        Trusted Movers. Proudly Serving <br class="hidden md:block" />
        <span class="text-primary">Northern Michigan.</span>
      </h2>
      <p class="mt-6 text-lg md:text-[19px] text-gray-500 font-medium leading-relaxed max-w-2xl mx-auto">
        We're proud to be the moving company families and businesses rely on <br class="hidden md:block" />
        for a smooth, stress-free moving experience.
      </p>
    </div>

    <!-- Review Section -->
    <div class="mt-14 w-full max-w-3xl grid grid-cols-1 md:grid-cols-2 relative trust-animate opacity-0 translate-y-8" style="transition-delay: 100ms;">
      <!-- Vertical Divider -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gray-200/80 -translate-x-1/2"></div>
      
      <!-- Google -->
      <div class="flex flex-col items-center pb-8 md:pb-0 md:pr-12">
        <div class="w-16 h-16 flex items-center justify-center bg-white rounded-full shadow-[0_2px_10px_rgba(0,0,0,0.06)] mb-5">
          <svg viewBox="0 0 24 24" class="w-8 h-8" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
        </div>
        <div class="flex space-x-1.5 mb-2.5 text-[#FFB400]">
          {Array(5).fill(0).map(() => (
            <svg class="w-[22px] h-[22px] fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          ))}
        </div>
        <div class="text-[17px] font-bold text-dark-navy">5.0 Star Rating</div>
        <div class="text-[15px] text-gray-500 mt-0.5">Based on 100+ Reviews</div>
      </div>

      <!-- Facebook -->
      <div class="flex flex-col items-center pt-8 md:pt-0 md:pl-12 border-t md:border-t-0 border-gray-200/80">
        <div class="w-16 h-16 flex items-center justify-center bg-[#1877F2] rounded-full shadow-[0_2px_10px_rgba(24,119,242,0.2)] mb-5">
          <svg viewBox="0 0 24 24" class="w-9 h-9 fill-white" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/>
          </svg>
        </div>
        <div class="flex space-x-1.5 mb-2.5 text-[#FFB400]">
          {Array(5).fill(0).map(() => (
            <svg class="w-[22px] h-[22px] fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          ))}
        </div>
        <div class="text-[17px] font-bold text-dark-navy">5.0 Star Rating</div>
        <div class="text-[15px] text-gray-500 mt-0.5">Based on 80+ Reviews</div>
      </div>
    </div>

    <!-- Service Areas -->
    <div class="mt-20 w-full text-center max-w-6xl trust-animate opacity-0" style="transition-delay: 200ms;">
      <h3 class="text-xl font-bold text-dark-navy mb-5 tracking-tight">Proudly Serving 20+ Communities Across Northern Michigan</h3>
      <div class="flex flex-wrap justify-center items-center gap-y-3 gap-x-3 text-[15px] font-bold text-dark-navy">
        {communities.map((city, index) => (
          <>
            <span>{city}</span>
            {index < communities.length - 1 && <span class="text-primary text-[10px] mx-1">●</span>}
          </>
        ))}
      </div>
    </div>

    <!-- CTA & Feature Row -->
    <div class="mt-20 w-full max-w-[1200px] grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-8 items-center border-t border-gray-200/80 pt-10 trust-animate opacity-0 translate-y-6" style="transition-delay: 300ms;">
      
      <!-- Left Feature -->
      <div class="flex items-start space-x-5 justify-start lg:justify-end pr-0 lg:pr-4 relative">
        <div class="text-primary mt-1">
          <svg class="w-[42px] h-[42px]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div class="max-w-[220px]">
          <h4 class="font-bold text-[17px] text-dark-navy">Fully Licensed & Insured</h4>
          <p class="text-[14px] text-gray-500 mt-1.5 leading-snug">Your belongings are in safe hands from start to finish.</p>
        </div>
      </div>

      <!-- Center CTA -->
      <div class="flex flex-col items-center justify-center text-center px-4 lg:px-8 lg:border-l lg:border-r border-gray-200/80 cta-animate relative">
        <a href="/quote" class="w-full sm:w-auto inline-flex justify-center items-center px-8 py-3.5 bg-primary text-white text-[15px] font-bold rounded-lg hover:bg-blue-600 transition-colors duration-200">
          GET A FREE QUOTE <span class="ml-2 font-normal">→</span>
        </a>
        <div class="mt-4 text-[17px] text-dark-navy">
          or Call <a href="tel:2313429505" class="text-primary font-bold hover:underline">(231) 342-9505</a>
        </div>
      </div>

      <!-- Right Feature -->
      <div class="flex items-start space-x-5 pl-0 lg:pl-4">
        <div class="text-primary mt-1">
          <svg class="w-[42px] h-[42px]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div class="max-w-[220px]">
          <h4 class="font-bold text-[17px] text-dark-navy">Professional & Reliable Team</h4>
          <p class="text-[14px] text-gray-500 mt-1.5 leading-snug">Experienced movers committed to exceptional service.</p>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Forest edge blends into the section instead of ending as a hard image strip. -->
  <div class="forest-edge w-full mt-24 aspect-[16/9] max-h-[520px] pointer-events-none relative z-0 overflow-hidden">
    <img src="/images/pine-forest-silhouette.png" alt="Northern Michigan Pine Forest" class="block w-full h-full object-cover" style="object-position: 50% 58%;" />
  </div>
</section>

<style>
  .trust-section {
    padding-block-start: var(--section-space);
  }
</style>

<style>
  .animate-in {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-in-fade {
    animation: fadeIn 1s ease-out forwards;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .forest-edge {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 34%, black 50%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 34%, black 50%, transparent 100%);
  }
</style>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        if (entry.target.classList.contains('opacity-0') && !entry.target.classList.contains('translate-y-6') && !entry.target.classList.contains('translate-y-8')) {
          entry.target.classList.add('animate-in-fade');
        } else {
          entry.target.classList.add('animate-in');
        }
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // In Astro, script tags are type="module" by default and run after the DOM is parsed.
  // We don't need DOMContentLoaded, which might have already fired.
  const initObserver = () => {
    const animatableElements = document.querySelectorAll('.trust-animate');
    animatableElements.forEach(el => observer.observe(el));
  };
  
  initObserver();
</script>
