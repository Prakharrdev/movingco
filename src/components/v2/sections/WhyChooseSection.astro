---
---

<section class="section-space-compact bg-[var(--color-dark-navy)]">
  <div class="site-container">
    <div class="why-choose-layout flex flex-col lg:flex-row lg:items-center">

      <!-- Left: Title & Description -->
      <div class="why-choose-intro text-center lg:text-left relative">
        <div class="w-10 h-[3px] rounded bg-[var(--color-primary)] mb-4 mx-auto lg:mx-0"></div>
        <h2 class="text-[24px] md:text-[26px] font-extrabold text-white leading-tight tracking-tight mb-1">
          Why Choose <br class="hidden md:block" />Ascension Moving?
        </h2>
        <p class="text-white/65 text-[15px] font-medium leading-relaxed mt-4">
          We combine experience, care, and integrity on every job — big or small.
        </p>
        <!-- Vertical divider (desktop) -->
        <div class="hidden lg:block absolute right-0 top-[10%] bottom-[10%] w-px bg-white/10"></div>
      </div>

      <!-- Right: 4 Features -->
      <div class="why-choose-features">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-6">

          <div class="text-center lg:text-left relative">
            <div class="w-[52px] h-[52px] rounded-[12px] bg-[var(--color-primary)]/15 flex items-center justify-center mx-auto lg:mx-0 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-accent)]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h4 class="font-bold text-white text-[16px] mb-2">Licensed & Insured</h4>
            <p class="text-white/60 text-[14px] leading-relaxed">Fully licensed, bonded, and insured for your peace of mind.</p>
            <div class="hidden lg:block absolute right-0 top-[15%] bottom-[15%] w-px bg-white/10"></div>
          </div>

          <div class="text-center lg:text-left relative">
            <div class="w-[52px] h-[52px] rounded-[12px] bg-[var(--color-primary)]/15 flex items-center justify-center mx-auto lg:mx-0 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-accent)]"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h4 class="font-bold text-white text-[16px] mb-2">On-Time & Reliable</h4>
            <p class="text-white/60 text-[14px] leading-relaxed">We respect your time and show up when we say we will.</p>
            <div class="hidden lg:block absolute right-0 top-[15%] bottom-[15%] w-px bg-white/10"></div>
          </div>

          <div class="text-center lg:text-left relative">
            <div class="w-[52px] h-[52px] rounded-[12px] bg-[var(--color-primary)]/15 flex items-center justify-center mx-auto lg:mx-0 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-accent)]"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h4 class="font-bold text-white text-[16px] mb-2">Professional Movers</h4>
            <p class="text-white/60 text-[14px] leading-relaxed">Experienced, trained movers who treat your belongings like their own.</p>
            <div class="hidden lg:block absolute right-0 top-[15%] bottom-[15%] w-px bg-white/10"></div>
          </div>

          <div class="text-center lg:text-left">
            <div class="w-[52px] h-[52px] rounded-[12px] bg-[var(--color-primary)]/15 flex items-center justify-center mx-auto lg:mx-0 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-accent)]"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h4 class="font-bold text-white text-[16px] mb-2">Satisfaction Guaranteed</h4>
            <p class="text-white/60 text-[14px] leading-relaxed">We stand behind our work with honest pricing and quality service.</p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .why-choose-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 5vw, 3rem);
  }

  .why-choose-intro,
  .why-choose-features {
    min-inline-size: 0;
  }

  @media (max-width: 63.999rem) {
    .why-choose-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
