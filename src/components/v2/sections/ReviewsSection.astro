---
import ReviewCarousel from './ReviewCarousel.astro';
import CustomShapeDivider from '../../shared/CustomShapeDivider.astro';
---

<section class="reviews-section relative overflow-hidden bg-[var(--color-dark-navy)]">

  <!-- Top Wave Divider (light-gray flowing into dark-navy) -->
  <CustomShapeDivider fill="light" position="top" />

  <div class="site-container relative z-20 flex flex-col items-center">
    <!-- Header Content -->
    <div class="text-center mb-16 max-w-3xl">
      <h2 class="text-white text-3xl md:text-[48px] font-bold leading-tight mb-4">
        What Our Customers Say
      </h2>
      <p class="text-white/90 text-base md:text-[20px] font-medium">
        Real reviews from families and businesses across Northern Michigan.
      </p>
    </div>

    <!-- Carousel -->
    <div class="w-full">
      <ReviewCarousel />
    </div>
  </div>

  <!-- Bottom Wave Divider (dark-navy flowing into light-gray) -->
  <CustomShapeDivider fill="light" position="bottom" />
</section>

<style>
  .reviews-section {
    padding-block: var(--section-space);
  }
</style>
