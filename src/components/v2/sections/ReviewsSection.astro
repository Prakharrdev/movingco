---
import ReviewCarousel from './ReviewCarousel.astro';

// Using a slightly flatter wave path for top/bottom dividers
const flatWavePath = "M0,64L80,58.7C160,53,320,43,480,48C640,53,800,75,960,74.7C1120,75,1280,53,1360,42.7L1440,32L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z";
---

<section class="relative py-32 overflow-hidden bg-[var(--color-dark-navy)]">

  <!-- Top Flat Wave Divider -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-[0] z-20 rotate-180">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="relative block w-full h-[40px] md:h-[60px]">
      <path d={flatWavePath} fill="var(--color-light-gray)"></path>
    </svg>
  </div>

  <div class="relative z-20 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
    <!-- Header Content -->
    <div class="text-center mb-16 max-w-3xl">
      <h2 class="text-white text-[48px] font-bold leading-tight mb-4">
        What Our Customers Say
      </h2>
      <p class="text-white/90 text-[20px] font-medium">
        Real reviews from families and businesses across Northern Michigan.
      </p>
    </div>

    <!-- Carousel -->
    <div class="w-full">
      <ReviewCarousel />
    </div>
  </div>

  <!-- Bottom Flat Wave Divider -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20 translate-y-[1px]">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="relative block w-full h-[40px] md:h-[60px]">
      <path d={flatWavePath} fill="var(--color-light-gray)"></path>
    </svg>
  </div>
</section>
