---
import type { Review } from '../../../data/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;

// Helper to render stars
const stars = Array.from({ length: 5 });
---

<div class="review-card h-full bg-white rounded-2xl shadow-md transition-all duration-300 hover:-translate-y-[6px] hover:shadow-xl flex flex-col">
  <div class="flex items-start justify-between mb-6">
    <div class="flex items-center gap-4">
      <div
        class="flex items-center justify-center w-12 h-12 rounded-full text-white font-bold text-xl flex-shrink-0"
        style={`background-color: ${review.avatarColor}`}
      >
        {review.initial}
      </div>
      <div class="flex flex-col justify-center">
        <h4 class="font-bold text-dark-navy leading-tight">{review.name}</h4>
        <span class="text-sm text-gray-500 mt-0.5">{review.date}</span>
      </div>
    </div>
    <div class="flex-shrink-0 mt-1">
      <!-- Google Logo -->
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M23.745 12.27c0-.827-.067-1.627-.206-2.392H12.24v4.524h6.452a5.508 5.508 0 0 1-2.387 3.615v2.998h3.863c2.261-2.083 3.577-5.148 3.577-8.745Z"/>
        <path fill="#34A853" d="M12.24 24c3.238 0 5.955-1.07 7.94-2.905l-3.863-2.998c-1.076.721-2.455 1.147-4.077 1.147-3.136 0-5.789-2.118-6.737-4.966H1.542v3.097A11.96 11.96 0 0 0 12.24 24Z"/>
        <path fill="#FBBC05" d="M5.503 14.278a7.135 7.135 0 0 1-.371-2.278c0-.792.14-1.558.371-2.278V6.625H1.542A11.97 11.97 0 0 0 0 12c0 1.93.456 3.753 1.262 5.375l3.96-3.097l.281 0Z"/>
        <path fill="#EA4335" d="M12.24 4.805c1.761 0 3.344.606 4.588 1.796l3.435-3.435C18.192 1.205 15.475 0 12.24 0 7.424 0 3.237 2.766 1.168 6.945l3.96 3.097c.948-2.848 3.601-5.237 6.737-5.237Z"/>
      </svg>
    </div>
  </div>

  <div class="flex gap-1 mb-5">
    {stars.map((_, i) => (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="#FBBC05"
        class={`w-[22px] h-[22px] ${i < review.stars ? 'text-[#FBBC05]' : 'text-gray-300'}`}
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    ))}
  </div>

  <p class="review-card-copy leading-[1.75] text-gray-700 flex-grow">
    {review.text}
  </p>
</div>

<style>
  .review-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  .review-card-copy {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }
</style>
