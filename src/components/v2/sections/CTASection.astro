---
// CTASection.astro
---

<section class="cta-section relative py-12 px-6 sm:px-12 md:px-24 flex items-center justify-between flex-col md:flex-row text-white overflow-hidden bg-[#0F2F4E]">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/pine-forest-silhouette.png" 
      alt="Pine Forest Background" 
      class="w-full h-full object-cover object-center opacity-40 mix-blend-overlay"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a1e32]/90 to-[#12395e]/80"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-2xl mb-6 md:mb-0 text-center md:text-left">
    <h2 class="text-3xl sm:text-4xl font-bold mb-3 tracking-tight">Ready to Make Your Move?</h2>
    <p class="text-lg text-white/90">Our team is ready to help. Get your free quote today!</p>
  </div>

  <div class="relative z-10 flex flex-col items-center md:items-end gap-3">
    <a 
      href="/contact-us" 
      class="inline-flex items-center justify-center bg-white text-[#2563EB] font-bold py-3 px-6 rounded shadow hover:bg-gray-50 transition duration-300 text-sm uppercase tracking-wide"
    >
      Get a free quote &rarr;
    </a>
    <p class="text-sm font-medium text-white/90">
      or Call <a href="tel:2313429505" class="text-[#60A5FA] hover:text-white transition-colors">(231) 342-9505</a>
    </p>
  </div>
</section>
