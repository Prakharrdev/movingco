---
interface Props {
  floating?: boolean;
}

const { floating = false } = Astro.props;
---

<section class:list={['cta-section', { 'cta-section--floating': floating }]}>
  <div class="site-container">
    <div class="rounded-2xl bg-white shadow-lg overflow-hidden">
      <div class="cta-content flex flex-col lg:flex-row items-center justify-between gap-6">
        <!-- Left: Text -->
        <div class="text-center lg:text-left">
          <h2 class="text-[28px] md:text-[32px] font-extrabold text-dark-navy leading-tight tracking-tight mb-2">
            Ready to Make Your Move?
          </h2>
          <p class="text-gray-500 text-[16px] font-medium">
            Get a free quote today and experience the Ascension difference.
          </p>
        </div>
        <!-- Right: Buttons -->
        <div class="flex items-center gap-4 flex-wrap justify-center lg:justify-end">
          <a href="/contact-us"
            class="inline-flex items-center gap-2 px-8 py-3.5 bg-[var(--color-primary)] hover:bg-blue-600 text-white text-[15px] font-bold rounded-lg transition-colors">
            GET A FREE QUOTE
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="tel:2313429505"
            class="inline-flex items-center gap-2 px-6 py-3.5 border-2 border-gray-200 hover:border-[var(--color-primary)] text-dark-navy text-[15px] font-bold rounded-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            (231) 342-9505
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  :global(.cta-section.cta-section--floating) {
    position: relative;
    z-index: 10;
    padding-block: 0;
    margin-block-start: -4rem;
    margin-block-end: 0;
  }

  @media (min-width: 64rem) {
    :global(.cta-section.cta-section--floating) {
      margin-block-start: -10rem;
    }
  }

  .cta-content {
    padding: clamp(1.5rem, 4vw, 3rem);
  }
</style>
