---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import CtaSection from '../components/v2/sections/CtaSection.astro';
import WhyChooseSection from '../components/v2/sections/WhyChooseSection.astro';
import ProcessSection from '../components/v2/sections/ProcessSection.astro';
import About from '../components/about/About.astro';
import Services from '../components/services/Services.astro';
import ReviewsSection from '../components/v2/sections/ReviewsSection.astro';
import RecentWorkSection from '../components/v2/sections/RecentWorkSection.astro';
import TrustSection from '../components/v2/sections/TrustSection.astro';
import MapSection from '../components/v2/sections/MapSection.astro';
import Footer from '../components/layout/Footer.astro';
---

<Base title="Contact Us — Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)]">
    <ContactHero />
    <CtaSection />
    <WhyChooseSection />
    <ProcessSection />
    <About />
    <Services />
    <ReviewsSection />
    <RecentWorkSection />
    <TrustSection />
    <MapSection />
    <Footer />
  </main>
</Base>
