---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TrustSection from '../../components/v2/sections/TrustSection.astro';
import ReviewsSection from '../../components/v2/sections/ReviewsSection.astro';
import MapSection from '../../components/v2/sections/MapSection.astro';
import Footer from '../../components/layout/Footer.astro';
---

<Base title="Kingsley Moving Services | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)]">
    <PageHero
      title="Kingsley Moving Services"
      subtitle="Trusted local movers serving Kingsley and the surrounding area."
      image="/images/new-herosection.png"
      imageFullWidth
      centerContent
      compact
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Kingsley Moving Services", href: "/service-area/kingsley-moving-services" }
      ]}
      cta={{ label: "Get a Free Quote", href: "/contact-us" }}
    />

    <section class="relative w-full bg-white py-16 lg:py-24">
      <div class="site-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-10 lg:gap-16">

          <div class="relative w-full rounded-[24px] overflow-hidden shadow-sm aspect-[4/3] lg:aspect-auto lg:h-[600px] border border-gray-100">
             <img
               src="/images/new-herosection.png"
               alt="Kingsley moving services"
               class="absolute inset-0 w-full h-full object-cover object-center"
             />
          </div>

          <div class="flex flex-col">
            <h2 class="text-[#D36A44] font-bold text-sm tracking-[0.15em] uppercase mb-3">
              Proudly Serving Kingsley
            </h2>
            <h3 class="text-[clamp(2rem,1.5rem+2vw,2.75rem)] font-extrabold text-[var(--color-dark-navy)] leading-[1.15] mb-6">
              Dependable Moving Services in Kingsley
            </h3>

            <div class="space-y-5 text-[#334155] text-lg leading-relaxed mb-8 font-medium">
              <p>
                Kingsley is a warm, family-friendly community just south of Traverse City, and we're proud to be the go-to movers for families and individuals in the area. From spacious rural properties to cozy in-town homes, we handle moves of every size.
              </p>

              <p>
                Our team knows the local roads, neighborhoods, and logistics that make a Kingsley move smooth and efficient. We treat every home like our own and every customer like a neighbor.
              </p>

              <ul class="list-none space-y-3 mt-6">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Residential moving for homes, farms, and rural properties.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Loading and unloading for rental trucks and containers.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Packing and unpacking services tailored to your needs.</span>
                </li>
              </ul>
            </div>

            <div class="pt-4">
              <a href="/contact-us" class="inline-flex items-center gap-2 bg-[var(--color-dark-navy)] text-white font-extrabold text-base px-7 py-4 rounded-[16px] hover:bg-[#D36A44] transition-colors shadow-sm">
                Schedule Your Kingsley Move
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <ReviewsSection />
    <TrustSection />
    <MapSection
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13562.200478141542!2d115.80141559999998!3d-31.810008649999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2a32ac53a20ebc81%3A0x504f0b535df48c0!2sKingsley%20WA%206026%2C%20Australia!5e0!3m2!1sen!2sin!4v1786046855917!5m2!1sen!2sin"
      title="Kingsley, WA 6026 — Service Area Map"
    />
    <Footer />
  </main>
</Base>
