---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TrustSection from '../../components/v2/sections/TrustSection.astro';
import ReviewsSection from '../../components/v2/sections/ReviewsSection.astro';
import MapSection from '../../components/v2/sections/MapSection.astro';
import Footer from '../../components/layout/Footer.astro';
---

<Base title="Kalkaska Moving Services | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)]">
    <PageHero
      title="Kalkaska Moving Services"
      subtitle="Trusted local movers serving Kalkaska and the surrounding area."
      image="/images/new-herosection.png"
      imageFullWidth
      centerContent
      compact
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Kalkaska Moving Services", href: "/service-area/kalkaska-moving-services" }
      ]}
      cta={{ label: "Get a Free Quote", href: "/contact-us" }}
    />

    <section class="relative w-full bg-white py-16 lg:py-24">
      <div class="site-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-10 lg:gap-16">

          <div class="relative w-full rounded-[24px] overflow-hidden shadow-sm aspect-[4/3] lg:aspect-auto lg:h-[600px] border border-gray-100">
             <img
               src="/images/new-herosection.png"
               alt="Kalkaska moving services"
               class="absolute inset-0 w-full h-full object-cover object-center"
             />
          </div>

          <div class="flex flex-col">
            <h2 class="text-[#D36A44] font-bold text-sm tracking-[0.15em] uppercase mb-3">
              Proudly Serving Kalkaska
            </h2>
            <h3 class="text-[clamp(2rem,1.5rem+2vw,2.75rem)] font-extrabold text-[var(--color-dark-navy)] leading-[1.15] mb-6">
              Reliable Moving Services in Kalkaska and Beyond
            </h3>

            <div class="space-y-5 text-[#334155] text-lg leading-relaxed mb-8 font-medium">
              <p>
                Nestled in the heart of Northern Michigan, Kalkaska is known for its lakes, trails, and small-town charm. Whether you're moving into town, out to a lakeside property, or somewhere in between, our team knows the area and handles your move with local expertise.
              </p>

              <p>
                From full-service residential moves to labor-only loading and unloading, we offer flexible moving solutions that fit your timeline, budget, and specific needs in Kalkaska County.
              </p>

              <ul class="list-none space-y-3 mt-6">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Residential and rural property moving services.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Heavy lifting and specialty item relocation.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Flexible packing, loading, and storage options.</span>
                </li>
              </ul>
            </div>

            <div class="pt-4">
              <a href="/contact-us" class="inline-flex items-center gap-2 bg-[var(--color-dark-navy)] text-white font-extrabold text-base px-7 py-4 rounded-[16px] hover:bg-[#D36A44] transition-colors shadow-sm">
                Schedule Your Kalkaska Move
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <ReviewsSection />
    <TrustSection />
    <MapSection
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d22674.889094952643!2d-85.18549555!3d44.73264855!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x881fef2e9062d19d%3A0x5358995fd70a6a94!2sKalkaska%2C%20MI%2049646%2C%20USA!5e0!3m2!1sen!2sin!4v1786048501283!5m2!1sen!2sin"
      title="Kalkaska, MI 49646 — Service Area Map"
    />
    <Footer />
  </main>
</Base>
