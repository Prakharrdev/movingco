---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TrustSection from '../../components/v2/sections/TrustSection.astro';
import ReviewsSection from '../../components/v2/sections/ReviewsSection.astro';
import MapSection from '../../components/v2/sections/MapSection.astro';
import Footer from '../../components/layout/Footer.astro';
---

<Base title="Traverse City Moving Services | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)]">
    <PageHero
      title="Traverse City Moving Services"
      subtitle="Trusted local movers serving Traverse City and the surrounding area."
      image="/images/new-herosection.png"
      imageFullWidth
      centerContent
      compact
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Traverse City Moving Services", href: "/service-area/traverse-city-moving-services" }
      ]}
      cta={{ label: "Get a Free Quote", href: "/contact-us" }}
    />

    <section class="relative w-full bg-white py-16 lg:py-24">
      <div class="site-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-10 lg:gap-16">

          <div class="relative w-full rounded-[24px] overflow-hidden shadow-sm aspect-[4/3] lg:aspect-auto lg:h-[600px] border border-gray-100">
             <img
               src="/images/new-herosection.png"
               alt="Traverse City moving services"
               class="absolute inset-0 w-full h-full object-cover object-center"
             />
          </div>

          <div class="flex flex-col">
            <h2 class="text-[#D36A44] font-bold text-sm tracking-[0.15em] uppercase mb-3">
              Proudly Serving Traverse City
            </h2>
            <h3 class="text-[clamp(2rem,1.5rem+2vw,2.75rem)] font-extrabold text-[var(--color-dark-navy)] leading-[1.15] mb-6">
              Your Local Traverse City Moving Experts
            </h3>

            <div class="space-y-5 text-[#334155] text-lg leading-relaxed mb-8 font-medium">
              <p>
                From the beaches of Grand Traverse Bay to the historic neighborhoods of downtown, we know every corner of Traverse City. As a locally operated moving company, we take pride in serving our community with reliable, friendly, and professional moving services.
              </p>

              <p>
                Whether you're moving into a condo near Front Street, relocating to a home in Old Mission Peninsula, or helping a family member settle in for retirement, our experienced crew handles your move with the care it deserves.
              </p>

              <ul class="list-none space-y-3 mt-6">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Local and long-distance moving throughout Traverse City.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Residential, apartment, and condo moving specialists.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Packing, loading, and unpacking services available.</span>
                </li>
              </ul>
            </div>

            <div class="pt-4">
              <a href="/contact-us" class="inline-flex items-center gap-2 bg-[var(--color-dark-navy)] text-white font-extrabold text-base px-7 py-4 rounded-[16px] hover:bg-[#D36A44] transition-colors shadow-sm">
                Schedule Your Traverse City Move
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <ReviewsSection />
    <TrustSection />
    <MapSection
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d45337.08964815576!2d-85.6053845!3d44.7488275!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x881e32b2d7da29dd%3A0x47bfdc3f3f745621!2sTraverse%20City%2C%20MI%2C%20USA!5e0!3m2!1sen!2sin!4v1786046508474!5m2!1sen!2sin"
      title="Traverse City, MI — Service Area Map"
    />
    <Footer />
  </main>
</Base>
