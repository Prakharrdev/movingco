---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TrustSection from '../../components/v2/sections/TrustSection.astro';
import ReviewsSection from '../../components/v2/sections/ReviewsSection.astro';
import MapSection from '../../components/v2/sections/MapSection.astro';
import Footer from '../../components/layout/Footer.astro';
---

<Base title="Local & Distance Moving | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)]">
    <PageHero
      title="Local & Distance Moving"
      subtitle="Reliable moves anywhere from Traverse City and beyond."
      image="/images/services/local-long-distance-moving.webp"
      imageFullWidth
      centerContent
      compact
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Moving Services", href: "/#services" },
        { label: "Local & Distance Moving", href: "/services/local-distance-moving" }
      ]}
      cta={{ label: "Get a Free Quote", href: "/contact-us" }}
    />

    <section class="relative w-full bg-white py-16 lg:py-24">
      <div class="site-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-10 lg:gap-16">

          <div class="relative w-full rounded-[24px] overflow-hidden shadow-sm aspect-[4/3] lg:aspect-auto lg:h-[600px] border border-gray-100">
             <img
               src="/images/services/local-long-distance-moving.webp"
               alt="Local and long-distance moving"
               class="absolute inset-0 w-full h-full object-cover object-center"
             />
          </div>

          <div class="flex flex-col">
            <h2 class="text-[#D36A44] font-bold text-sm tracking-[0.15em] uppercase mb-3">
              Reliable Moving Services
            </h2>
            <h3 class="text-[clamp(2rem,1.5rem+2vw,2.75rem)] font-extrabold text-[var(--color-dark-navy)] leading-[1.15] mb-6">
              Seamless Moves Across Town or Across the State
            </h3>

            <div class="space-y-5 text-[#334155] text-lg leading-relaxed mb-8 font-medium">
              <p>
                Whether you're relocating down the street in Traverse City or heading to a new home across Michigan, our local and long-distance moving services are designed to make your transition smooth and worry-free.
              </p>

              <p>
                From planning to execution, our experienced team handles every aspect of your move with care and precision so you can focus on settling into your new space.
              </p>

              <ul class="list-none space-y-3 mt-6">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Local moves within Northern Michigan.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Long-distance moves across Michigan and beyond.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#D36A44] flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Flexible scheduling and transparent pricing.</span>
                </li>
              </ul>
            </div>

            <div class="pt-4">
              <a href="/contact-us" class="inline-flex items-center gap-2 bg-[var(--color-dark-navy)] text-white font-extrabold text-base px-7 py-4 rounded-[16px] hover:bg-[#D36A44] transition-colors shadow-sm">
                Plan Your Move Today
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <ReviewsSection />
    <TrustSection />
    <MapSection />
    <Footer />
  </main>
</Base>
