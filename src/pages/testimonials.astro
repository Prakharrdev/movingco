---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import PageHero from '../components/hero/PageHero.astro';
import ReviewCard from '../components/v2/sections/ReviewCard.astro';
import { reviews, googleReviewsUrl } from '../data/reviews';
import TrustSection from '../components/v2/sections/TrustSection.astro';
import CTASection from '../components/v2/sections/CTASection.astro';
import MapSection from '../components/v2/sections/MapSection.astro';
import Footer from '../components/layout/Footer.astro';
---

<Base title="Testimonials | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)]">
    <!-- Hero Section -->
    <PageHero
      title="What Our Customers Say"
      subtitle="Real reviews from families and businesses across Northern Michigan."
      image="/images/new-herosection.png"
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Testimonials", href: "/testimonials" }
      ]}
      cta={{ label: "Leave a Review", href: googleReviewsUrl }}
    >
      <div slot="right-content" class="bg-white p-6 md:p-8 rounded-[20px] shadow-[0_8px_30px_rgba(0,0,0,0.04)] border border-gray-100 flex items-center gap-5 md:gap-6 hover:-translate-y-1 transition-transform duration-300">
        <div class="flex-shrink-0 flex items-center justify-center w-[72px] h-[72px] bg-white rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.08)]">
          <svg class="w-10 h-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.827-.067-1.627-.206-2.392H12.24v4.524h6.452a5.508 5.508 0 0 1-2.387 3.615v2.998h3.863c2.261-2.083 3.577-5.148 3.577-8.745Z"/>
            <path fill="#34A853" d="M12.24 24c3.238 0 5.955-1.07 7.94-2.905l-3.863-2.998c-1.076.721-2.455 1.147-4.077 1.147-3.136 0-5.789-2.118-6.737-4.966H1.542v3.097A11.96 11.96 0 0 0 12.24 24Z"/>
            <path fill="#FBBC05" d="M5.503 14.278a7.135 7.135 0 0 1-.371-2.278c0-.792.14-1.558.371-2.278V6.625H1.542A11.97 11.97 0 0 0 0 12c0 1.93.456 3.753 1.262 5.375l3.96-3.097l.281 0Z"/>
            <path fill="#EA4335" d="M12.24 4.805c1.761 0 3.344.606 4.588 1.796l3.435-3.435C18.192 1.205 15.475 0 12.24 0 7.424 0 3.237 2.766 1.168 6.945l3.96 3.097c.948-2.848 3.601-5.237 6.737-5.237Z"/>
          </svg>
        </div>
        <div>
          <div class="text-[36px] font-extrabold text-[var(--color-dark-navy)] leading-none mb-1.5 flex items-end gap-2">
            5.0
            <span class="text-base text-gray-500 font-bold mb-1 uppercase tracking-wider">Rating</span>
          </div>
          <div class="flex gap-1 mb-2">
            {[1, 2, 3, 4, 5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#FBBC05" class="w-5 h-5">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-gray-600 font-medium">Based on verified Google Reviews</p>
        </div>
      </div>
    </PageHero>

    <!-- Testimonials Grid Section -->
    <section class="py-16 md:py-24 relative overflow-hidden bg-[var(--color-light-gray)]">
      <div class="site-container relative z-10">
        <!-- Header Content if needed, but PageHero covers it. We can add a subtle intro here if desired -->
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <h2 class="text-[var(--color-dark-navy)] text-3xl md:text-[40px] font-bold leading-tight mb-4">
            Hear From Our Clients
          </h2>
          <p class="text-gray-600 text-base md:text-lg">
            We take pride in delivering exceptional moving experiences. Read what our past clients have to say about working with Ascension Moving Company.
          </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {reviews.map((review) => (
            <ReviewCard review={review} />
          ))}
        </div>
      </div>
    </section>

    <TrustSection />
    <CTASection floating />
    <MapSection />
    <Footer />
  </main>
</Base>
