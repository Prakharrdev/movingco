---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import PageHero from '../components/hero/PageHero.astro';
import AboutUsSection from '../components/about-us/AboutUsSection.astro';
import MovingProcessSection from '../components/about-us/MovingProcessSection.astro';
import Services from '../components/services/Services.astro';
import ReviewsSection from '../components/v2/sections/ReviewsSection.astro';
import TrustSection from '../components/v2/sections/TrustSection.astro';
import MapSection from '../components/v2/sections/MapSection.astro';
import Footer from '../components/layout/Footer.astro';
---

<Base title="About Us | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)] lg:pt-0">
    <div class="lg:hidden">
      <PageHero
        title="Built on Integrity. Focused on People."
        subtitle="Every move matters. We treat every customer like family and every home like our own."
        image="/images/about us/hero-img.png"
        crumbs={[
          { label: "Home", href: "/" },
          { label: "About Us", href: "/about-us" }
        ]}
        cta={{ label: "Get a Free Quote", href: "/contact-us" }}
      />
    </div>
    <AboutUsSection />
    <MovingProcessSection />
    <Services />
    <ReviewsSection />
    <TrustSection />
    <MapSection />
    <Footer />
  </main>
</Base>
