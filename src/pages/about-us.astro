---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import AboutUsSection from '../components/about-us/AboutUsSection.astro';
import MovingProcessSection from '../components/about-us/MovingProcessSection.astro';
import TrustSection from '../components/v2/sections/TrustSection.astro';
import CTASection from '../components/v2/sections/CTASection.astro';
import Footer from '../components/layout/Footer.astro';
---

<Base title="About Us | Ascension Moving Company">
  <Navbar />
  <main class="w-full bg-[var(--color-light-gray)] pt-[100px]">
    <AboutUsSection />
    <MovingProcessSection />
    <TrustSection />
    <CTASection />
    <Footer />
  </main>
</Base>

